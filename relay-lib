# Shared by relay-events and relay-follow; sourced, not run.

# Commands that open the keystore read the passphrase from here unless told otherwise.
if [[ -z ${TOON_PASSPHRASE_FILE:-} && -z ${TOON_PASSPHRASE:-} && -r $HOME/.config/toon/passphrase ]]; then
  export TOON_PASSPHRASE_FILE=$HOME/.config/toon/passphrase
fi

relay_read_address() {
  toon status --json 2>/dev/null |
    jq -r '.agent_node.toon_apps[]?.apps[]? | select(.name == "relay" and .running) | .read_address // empty' 2>/dev/null |
    head -n1
}

relay_query() {
  toon event query "ws://$read_address" --filter "$1" --json 2>/dev/null | jq -c '.events // []' 2>/dev/null || echo '[]'
}

# The agent identity's public key. It is public, so it is cached to keep the
# keystore closed on every refresh; a newer keystore invalidates the cache.
agent_identity() {
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/spaceturtle/identity
  local keystore=$HOME/.toon/agent-node/keystore.json
  if [[ ! -s $cache || $keystore -nt $cache ]]; then
    local key
    key=$(toon wallet show --json 2>/dev/null | jq -r '.wallet.agent_identity // empty' 2>/dev/null)
    [[ $key =~ ^[0-9a-f]{64}$ ]] || return 0
    mkdir -p "$(dirname "$cache")" && printf '%s\n' "$key" > "$cache"
  fi
  cat "$cache"
}
