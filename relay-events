#!/bin/bash
# Print what can be observed of this agent node as one JSON document:
# {"online", "name", "self", "node", "subscribers", "state", "profiles",
# "follows", "events"}. Read-only: nothing here opens the keystore, spends,
# changes state or publishes. Only free `toon` commands are run: status,
# relay config, peer list, channel list, route list, limit show,
# relay subscriptions and logs. Wallet balances are never read (they need the
# passphrase, ADR 0001).
#
# "state" is the node as `toon` reports it, or null when there is no agent node.
# Each group in it (status, relay, peers, channels, routes, limits,
# subscriptions, logs) is null when its command failed or returned an error
# document, so the rest still shows.
#
# The relay's read port changes on every `toon up`, so it is looked up from
# `toon status` each time. Environment, so that tests can run against a stub:
#   SPACETURTLE_TOON        the toon command (default: toon)
#   SPACETURTLE_CONFIG_DIR  where the agent writes its public key, in the file
#                           `agent-pubkey` (default: ~/.config/spaceturtle)
#   HOME                    ~/.local/bin is put on PATH
set -uo pipefail
PATH="$HOME/.local/bin:$PATH"

toon_cmd=${SPACETURTLE_TOON:-toon}
config_dir=${SPACETURTLE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/spaceturtle}

limit=${1:-40}
[[ $limit =~ ^[0-9]+$ ]] || limit=40

offline() {
  printf '{"online":false,"name":"","self":"","node":{"ilp_address":"","connector":""},"subscribers":null,"state":%s,"profiles":[],"follows":[],"events":[]}\n' "${state:-null}"
  exit 0
}

toon() { command "$toon_cmd" "$@"; }

# The JSON a free toon command printed, or null if it failed, printed nothing
# or printed an error document.
toon_json() {
  local out
  out=$(if command -v timeout >/dev/null; then timeout 10 "$toon_cmd" "$@"; else "$toon_cmd" "$@"; fi 2>/dev/null) || { echo null; return; }
  out=$(jq -c 'if type == "object" and has("error") then null else . end' <<<"$out" 2>/dev/null)
  echo "${out:-null}"
}

relay_query() {
  toon event query "ws://$read_address" --filter "$1" --json 2>/dev/null | jq -c '.events // []' 2>/dev/null || echo '[]'
}

state=null
command -v "$toon_cmd" >/dev/null && command -v jq >/dev/null || offline
status=$(toon_json status --json)
relay_config=$(toon_json relay config --json)

# The node's state, from free commands only. A group whose command failed is null.
if jq -e '.agent_node | type == "object"' <<<"$status" >/dev/null 2>&1; then
  state=$(jq -cn --argjson status "$status" --argjson relay "$relay_config" \
    --argjson peers "$(toon_json peer list --json)" \
    --argjson channels "$(toon_json channel list --json)" \
    --argjson routes "$(toon_json route list --json)" \
    --argjson limits "$(toon_json limit show --json)" \
    --argjson held "$(toon_json relay subscriptions --json)" \
    --argjson incoming "$(toon_json relay subscriptions --incoming --json)" \
    --argjson logs "$(toon_json logs --json)" '
    def str: if . == null then "" elif type == "string" then . else tojson end;
    def items(key): if . == null then null
      elif type == "array" then . else (.[key] // ([.. | arrays] | first) // []) end;
    def running: if . == null then null else ([.running, .up] | map(select(. != null)) | if length > 0 then .[0] else null end) end;
    ($status.agent_node) as $n
    | {
      status: {
        supervisor: ($n.supervisor | running),
        connector: ($n.connector | running),
        apps: [$n.toon_apps[]?.apps[]? | {name: (.name | str), running: (.running == true),
          restarts: (.restarts // .restart_count // 0)}]
      },
      relay: (if $relay == null then null else {
        name: ($relay.relay.name // $relay.name | str),
        prices: [($relay.relay.prices // $relay.relay.pricing // $relay.prices // {}) | to_entries[]? | {name: .key, price: (.value | str)}],
        blocklist: [($relay.relay.blocklist // $relay.blocklist // [])[]? | str]
      } end),
      peers: ($peers | items("peers") | if . == null then null else [.[] | {
        id: (.id // .peer_id // .peer // .address // .name | str),
        direction: (.direction | str), status: (.status // .state | str)}] end),
      channels: ($channels | items("channels") | if . == null then null else [.[] | {
        peer: (.peer // .peer_id // .counterparty // .id | str),
        direction: (.direction | str), status: (.status // .state | str),
        collateral: (.collateral // .capacity // .deposit | str)}] end),
      routes: ($routes | items("routes") | if . == null then null else [.[] | {
        prefix: (.prefix // .destination // .route | str),
        peer: (.peer // .next_hop // .via | str), price: (.price // .rate | str)}] end),
      limits: (if $limits == null then null else {
        per_command: ($limits.per_command // $limits.limits.per_command // $limits.command | str),
        per_day: ($limits.per_day // $limits.limits.per_day // $limits.daily // $limits.day | str),
        remaining_today: ($limits.remaining_today // $limits.remaining | str)} end),
      subscriptions: (if $held == null and $incoming == null then null else {
        held: ($held | items("subscriptions") | if . == null then null else [.[] | str] end),
        incoming: ($incoming | items("subscriptions") | if . == null then null else length end)} end),
      logs: ($logs | items("lines") | if . == null then null else [.[-20:][] | (if type == "object" then (.message // .line // .) else . end) | str] end)
    }' 2>/dev/null) || state=null
fi

read_address=$(jq -r '.agent_node.toon_apps[]?.apps[]? | select(.name == "relay" and .running) | .read_address // empty' <<<"$status" 2>/dev/null |
  head -n1)
[[ -n $read_address ]] || offline

# Notes, reposts, reactions, comments and long-form posts; then the profiles
# that name their authors and the follow lists that count their followers.
events=$(relay_query "{\"kinds\":[1,6,7,16,1111,30023],\"limit\":$limit}")
profiles=$(relay_query '{"kinds":[0],"limit":200}')
follows=$(relay_query '{"kinds":[3],"limit":500}')
name=$(jq -r '.relay.name // ""' <<<"$relay_config" 2>/dev/null)

# The agent identity's public key, from a file the agent writes during setup.
self=
if [[ -r $config_dir/agent-pubkey ]]; then
  read -r self < "$config_dir/agent-pubkey" || true
  [[ $self =~ ^[0-9a-f]{64}$ ]] || self=
fi

# The node's ILP address and connector address, from the relay's NIP-11 document.
node=
if command -v curl >/dev/null; then
  node=$(curl -fsS --max-time 5 -H 'Accept: application/nostr+json' "http://$read_address" 2>/dev/null |
    jq -c '{ilp_address: (.ilp_address | strings // ""), connector: (.connector | strings // "")}' 2>/dev/null)
fi

# Who holds a subscription to this relay's live feed; null while it is not sold.
subscribers=$(toon relay subscriptions --incoming --json 2>/dev/null |
  jq -c 'if .error then null else ([.. | arrays] | first // [] | length) end' 2>/dev/null)

jq -cn --arg name "${name:-}" --arg self "$self" \
  --argjson node "${node:-null}" \
  --argjson subscribers "${subscribers:-null}" --argjson state "$state" --argjson events "${events:-[]}" \
  --argjson profiles "${profiles:-[]}" --argjson follows "${follows:-[]}" \
  '{online: true, name: $name, self: $self,
    node: ($node // {ilp_address: "", connector: ""}),
    subscribers: $subscribers, state: $state, profiles: $profiles, follows: $follows, events: $events}'
