#!/bin/bash
# The launcher: the one program a person runs to have a spaceturtle.
#
#   spaceturtle start
#       Brings the connector's zone up, step by step, and does only the steps
#       not yet done, so a run that was interrupted finishes the rest when run
#       again and a second run creates, initialises and funds nothing:
#         1. zone        a detached Docker Sandboxes virtual machine made from the
#                        connector's zone image, with an any-address rule scoped to
#                        that zone alone; nothing is copied into it from the machine
#         2. node        the agent node, initialised on devnet inside it
#         3. faucet      the wallet funded from the devnet faucet
#         4. supervisor  the image's `connector-start` (the container engine, then
#                        `toon up`), started again whenever it is not running
#         5. backup      a sealed backup of the wallet, handed to the Observer
#       The passphrase is made inside the zone: it is never printed and never
#       written to the machine's disk. `upgrade` carries it in memory to the new zone.
#
#   spaceturtle stop
#       Stops the timer's unit (its on/off setting stays), a session in the agent's
#       zone, then the connector's zone. Loses nothing; `start` brings it back and
#       creates, initialises and funds nothing.
#   spaceturtle upgrade
#       Replaces the connector's zone with one from the newest connector's zone image,
#       leaving the wallet's storage as it was. A fresh backup comes first; if it fails,
#       or the passphrase cannot be read out of the old zone, nothing is changed. The
#       passphrase goes through the standard output and input of `sbx exec`, never an
#       argument, the environment or a file. The agent's zone is removed too.
#   spaceturtle backup
#       Writes a fresh sealed backup to the backup directory; the earlier one is replaced
#       only once the new one has arrived whole. Needs the connector's zone running.
#   spaceturtle remove [--delete-wallet]
#       Offers a fresh backup, then removes both zones, the timer's units, the step
#       markers, the settings and the model key. Keeps the wallet's storage and the
#       backup directory. --delete-wallet also deletes the wallet's storage, after the
#       word "delete" is typed; anything else changes nothing.
#
#   spaceturtle mainnet [--keep-limit]
#       Moves the Install from devnet to mainnet, once the person running it has
#       typed "mainnet" to confirm. It first says what changes: real funds are now at
#       stake, there is no faucet, and which addresses to fund. Without the typed
#       word nothing changes. It lowers the spending limit to the mainnet default
#       unless --keep-limit is given. On an Install already on mainnet it says so
#       and changes nothing.
#
#   spaceturtle session [--unattended]
#       Starts a `docker-agent` session in the agent's zone, from the agent's zone
#       image and the published agent definition. The session command carries an
#       allow-list of exactly two things: the model provider's host and one loopback
#       port, the one that leads to the connector's zone. By hand it is a
#       conversation; --unattended is what the timer runs: no one is present, and
#       the session has a ceiling on model cost. Nothing starts while the
#       connector's zone is not running.
#   spaceturtle timer on|off|interval <N>m|h|d
#       The timer starts an unattended session. `start` turns it on, every 6h,
#       unless it was turned off. It is a systemd user timer.
#   spaceturtle set model <provider/model>
#   spaceturtle set ceiling <dollars>
#       The model, and the ceiling on model cost of one unattended session (default 1).
#   spaceturtle key
#       Reads the model key from the terminal into the key file (mode 600).
#   spaceturtle waiting
#       Lists the apps the agent node holds until the Observer approves them: each
#       one's name, image and how long it has waited.
#   spaceturtle approve <app>
#       Approves a waiting app: `toon approve` starts it, and an image that is not
#       TOON's own runs under the sandboxed runtime (toon_cli#209).
#   spaceturtle refuse <app> [reason]
#       Refuses a waiting app and discards it.
#   spaceturtle status
#       The timer's state and interval, when the last unattended session started,
#       the model and the ceiling; the connector's zone (running, stopped, not created),
#       the agent's zone (in a session, idle), the network, each app and whether the
#       relay answers; whether the supervisor runs and how many apps wait. Exits 0
#       when the connector's zone is stopped or missing.
#   spaceturtle agent-key show
#       Prints the agent key's scope, limits and what is left today (read from the
#       agent's zone, which holds the key), and never the private half.
#   spaceturtle agent-key replace
#       Makes a new agent key, revokes the old one, and places the new private half in the
#       agent's zone. The wallet is untouched.
#   spaceturtle agent-key revoke
#       Removes the agent key from the agent node's list, so the agent's next order is
#       refused, and deletes the private half from the agent's zone. `start` does not
#       make another; `agent-key replace` does.
#   spaceturtle agent-key limit <amount>
#       Sets the agent key's spending limit. Only the Observer can: the agent has no tool for it.
#   `start` makes exactly one agent key, with the default scope (ADR 0003) and the default
#   spending limit, and puts its private half in the agent's zone and nowhere else: it goes
#   from the connector's zone, where `toon` writes it to a file that is deleted once it is
#   placed, to the agent's zone through a pipe, never through an argument, the machine or
#   the output of the launcher. A second run makes none, and neither does `upgrade` after
#   a revoke.
#   Approving or refusing an app that is not waiting says so and changes nothing.
#   `waiting`, `approve`, `refuse` and `status` run `toon` with the home, in the
#   connector's zone. The agent has no tool for them (tests/check-agent).
#
# The model key is the Observer's: it lives in a file outside every zone, is given
# to the session as an environment variable of the sbx process (never an argument)
# and is not in any directory the agent's file tool may read.
#
# Every command that uses a zone stops before doing anything when the machine has no
# KVM, `sbx` is missing or
# `sbx` is signed out, and says the cause and the remedy.
#
# Environment, so that tests can run against a temporary home:
#   SPACETURTLE_SBX         the sbx program (default: sbx)
#   SPACETURTLE_KVM         the KVM device (default: /dev/kvm)
#   SPACETURTLE_ZONE        the zone's name (default: st-connector)
#   SPACETURTLE_STATE_DIR   the state directory (default: ~/.local/state/spaceturtle);
#                           the launcher keeps its step markers in `launcher`
#   SPACETURTLE_DATA_DIR    the wallet's storage, outside the zone's image
#                           (default: ~/.local/share/spaceturtle/wallet)
#   SPACETURTLE_BACKUP_DIR  where the backup is written for the Observer
#                           (default: ~/spaceturtle-backup)
#   SPACETURTLE_CONFIG_DIR  the launcher's settings, in `launcher.conf`
#                           (default: ~/.config/spaceturtle)
#   SPACETURTLE_MODEL_KEY_FILE  the model key (default: ~/.config/spaceturtle-launcher/model-key)
#   SPACETURTLE_MODEL_HOST  the model provider's host, for a provider the launcher does not know
#   SPACETURTLE_CONNECTOR_IMAGE  the connector's zone image (default: ghcr.io/toon-protocol/spaceturtle-connector-zone:latest)
#   SPACETURTLE_AGENT_ZONE  the agent's zone's name (default: st-agent)
#   SPACETURTLE_AGENT_IMAGE the agent's zone image (default: ghcr.io/toon-protocol/spaceturtle-agent-zone:latest)
#   SPACETURTLE_AGENT_DEF   the agent definition (default: agent/spaceturtle.yaml beside this file)
#   SPACETURTLE_CONNECTOR_PORT  the loopback port that leads to the connector's zone (default: 7100)
#   SPACETURTLE_SYSTEMCTL   the systemctl program (default: systemctl)
#   SPACETURTLE_UNIT_DIR    where the timer's units are written (default: ~/.config/systemd/user)
set -uo pipefail

sbx=${SPACETURTLE_SBX:-sbx}
kvm=${SPACETURTLE_KVM:-/dev/kvm}
zone=${SPACETURTLE_ZONE:-st-connector}
state_dir=${SPACETURTLE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/spaceturtle}
marks=$state_dir/launcher
data_dir=${SPACETURTLE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/spaceturtle/wallet}
backup_dir=${SPACETURTLE_BACKUP_DIR:-$HOME/spaceturtle-backup}
config_dir=${SPACETURTLE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/spaceturtle}
conf=$config_dir/launcher.conf
key_file=${SPACETURTLE_MODEL_KEY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/spaceturtle-launcher/model-key}
connector_image=${SPACETURTLE_CONNECTOR_IMAGE:-ghcr.io/toon-protocol/spaceturtle-connector-zone:latest}
agent_zone=${SPACETURTLE_AGENT_ZONE:-st-agent}
agent_image=${SPACETURTLE_AGENT_IMAGE:-ghcr.io/toon-protocol/spaceturtle-agent-zone:latest}
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
agent_def=${SPACETURTLE_AGENT_DEF:-$here/agent/spaceturtle.yaml}
connector_port=${SPACETURTLE_CONNECTOR_PORT:-7100}
systemctl_=${SPACETURTLE_SYSTEMCTL:-systemctl}
unit_dir=${SPACETURTLE_UNIT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}

die() { echo "spaceturtle: $*" >&2; exit 1; }
say() { echo "spaceturtle: $*"; }
done_() { [[ -e $marks/$1 ]]; }
mark() { mkdir -p "$marks" && : > "$marks/$1"; }

# Where the agent key's private half lives in the agent's zone, outside the directories its file tool may read.
agent_key_path='$HOME/.config/toon-agent/key'

# Quotes a value for the zone's sh.
sh_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# Every command in the zone sees the passphrase file that lives in the zone.
in_zone() { "$sbx" exec "$zone" sh -c "export TOON_PASSPHRASE_FILE=\$HOME/.config/toon-passphrase; $1"; }

preflight() {
  [[ -e $kvm ]] || die "this machine has no KVM ($kvm), and the connector's zone is a virtual machine. Turn on virtualisation in the firmware (VT-x or AMD-V) and load the kvm module, or use a machine that has it."
  command -v "$sbx" >/dev/null 2>&1 || die "sbx (Docker Sandboxes) is not installed. Install it from https://github.com/docker/sbx-releases and run it again."
  "$sbx" ls >/dev/null 2>&1 || die "sbx is signed out or its daemon is not running. Run 'sbx login' and 'sbx daemon start -d', then run it again."
}

zone_exists() { "$sbx" ls 2>/dev/null | awk -v z="$zone" '$1 == z { found = 1 } END { exit !found }'; }

# The zone's state in `sbx ls`: running, stopped or "not created". Takes the zone's name.
zone_state() {
  "$sbx" ls 2>/dev/null | awk -v z="${1:-$zone}" '$1 == z { found = 1; run = ($0 ~ /running/) }
    END { print !found ? "not created" : run ? "running" : "stopped" }'
}

# Creates the connector's zone from the connector's zone image; the markers are the caller's.
create_zone() {
  mkdir -p "$data_dir" || die "cannot create $data_dir"
  "$sbx" policy init balanced || die "sbx policy init failed"
  "$sbx" create --name "$zone" --cpus 4 --memory 4g --template "$connector_image" shell "$data_dir" || die "sbx create failed"
}

step_zone() {
  if ! zone_exists; then
    say "creating the connector's zone ($zone)"
    create_zone
    # A new zone has none of the steps done in it, whatever an earlier zone had.
    rm -rf "$marks"
  elif [[ $(zone_state) == stopped ]]; then
    say "starting the connector's zone ($zone)"
    "$sbx" start "$zone" || die "sbx start failed"
  fi
  if ! done_ rule; then
    # The rule names the zone, so it is never machine-wide.
    "$sbx" policy allow network --sandbox "$zone" --protocol tcp,udp "**" || die "the any-address rule failed"
    mark rule
  fi
  if ! done_ zone; then
    # The image holds the overlay client's proxy setting. The wallet lives in the
    # mounted directory while the passphrase stays on the zone's own disk.
    in_zone 'mkdir -p ~/.config && ln -sfn '"$(sh_quote "$data_dir")"' ~/.config/toon' || die "the zone could not be set up"
    mark zone
  fi
}

step_node() {
  done_ node && return
  say "initialising the agent node on devnet"
  in_zone '{ [ -s "$TOON_PASSPHRASE_FILE" ] || { umask 077 && head -c 32 /dev/urandom | base64 > "$TOON_PASSPHRASE_FILE"; }; } &&
    toon init --accept-anyone-terms --network devnet --json >/dev/null' || die "toon init failed in the zone"
  mark node
}

step_faucet() {
  done_ faucet && return
  say "funding the wallet from the faucet"
  in_zone 'toon wallet fund --json >/dev/null' || die "toon wallet fund failed in the zone"
  mark faucet
}

# The pattern does not match itself, so the shell running pgrep is not taken for the supervisor.
supervisor_running() { in_zone 'pgrep -f "[t]oon up" >/dev/null'; }

step_supervisor() {
  supervisor_running && return
  say "starting the supervisor"
  # The image's entrypoint may not have run, so the launcher starts it; it reads the passphrase file in_zone names.
  in_zone 'setsid nohup connector-start > ~/up.log 2>&1 < /dev/null &' || die "connector-start failed in the zone"
}

# Writes a fresh sealed backup to the backup directory. The backup already there is
# replaced only once the new one has arrived whole.
make_backup() {
  mkdir -p "$backup_dir" && chmod 700 "$backup_dir" || return 1
  in_zone 'rm -f /tmp/wallet-backup; toon wallet backup --output /tmp/wallet-backup >/dev/null' || { echo "spaceturtle: toon wallet backup failed in the zone" >&2; return 1; }
  rm -f "$backup_dir/wallet-backup.new"
  if ! "$sbx" cp "$zone:/tmp/wallet-backup" "$backup_dir/wallet-backup.new" || [[ ! -s $backup_dir/wallet-backup.new ]]; then
    rm -f "$backup_dir/wallet-backup.new"
    echo "spaceturtle: the backup could not be copied out of the zone; the earlier backup, if any, is as it was" >&2
    return 1
  fi
  mv -f "$backup_dir/wallet-backup.new" "$backup_dir/wallet-backup" || return 1
  say "the backup is at $backup_dir/wallet-backup. Keep it: it is the only way back to the wallet and the agent's identity if the zone is lost."
}

step_backup() {
  done_ backup && return
  say "making the backup"
  make_backup || die "the backup failed"
  mark backup
}

# The network the node is on, from `toon status --json`; empty when it cannot be read.
node_network() {
  in_zone 'toon status --json' 2>/dev/null | jq -r '.network // .agent_node.network // empty' 2>/dev/null
}

mainnet() {
  local keep_limit=0 arg network addresses answer
  for arg in "$@"; do
    case $arg in
      --keep-limit) keep_limit=1 ;;
      *) die "usage: spaceturtle mainnet [--keep-limit]" ;;
    esac
  done
  preflight
  zone_exists || die "there is no connector's zone yet. Run 'spaceturtle start' first."
  command -v jq >/dev/null 2>&1 || die "jq is not installed, and it is needed to read the node's network."
  network=$(node_network)
  [[ -n $network ]] || die "the network the node is on could not be read from the zone. Run 'spaceturtle start' and try again."
  if [[ $network == mainnet ]]; then
    say "this Install is already on mainnet. Nothing was changed."
    return 0
  fi
  addresses=$(in_zone 'toon wallet addresses') || die "the wallet's addresses could not be read from the zone"
  [[ -n $addresses ]] || die "the zone listed no address to fund"
  cat <<EOF2
spaceturtle: this moves the Install from $network to mainnet.
  - Real funds are now at stake: whoever breaks into the connector's zone holds what is in these addresses.
  - There is no faucet on mainnet. Nothing is funded for you.
  - Fund only what you can afford to lose, at these addresses:
$(sed 's/^/      /' <<<"$addresses")
EOF2
  if (( keep_limit )); then
    say "the spending limit is kept as it is (--keep-limit)."
  else
    say "the spending limit will be lowered to the mainnet default."
  fi
  printf 'spaceturtle: type "mainnet" to go on: '
  IFS= read -r answer || answer=
  if [[ $answer != mainnet ]]; then
    echo
    say "not confirmed. Nothing was changed."
    return 1
  fi
  say "moving the node to mainnet"
  in_zone 'toon network set mainnet --json >/dev/null' || die "toon could not move the node to mainnet"
  if (( ! keep_limit )); then
    in_zone 'toon limit set --network-default --json >/dev/null' || die "the node is on mainnet, but the spending limit could not be lowered. Lower it before funding anything: $sbx exec $zone sh -c 'TOON_PASSPHRASE_FILE=\$HOME/.config/toon-passphrase toon limit set --network-default'"
  fi
  network=$(node_network)
  [[ $network == mainnet ]] || die "the node did not report mainnet afterwards (it says '${network:-nothing}')"
  say "the Install is on mainnet. Fund the addresses above."
}

# --- settings: `name=value` lines in launcher.conf ---
conf_get() { # name, default
  local v
  v=$(sed -n "s/^$1=//p" "$conf" 2>/dev/null | tail -n 1)
  echo "${v:-$2}"
}
conf_set() { # name, value
  mkdir -p "$config_dir" || die "cannot create $config_dir"
  { grep -v "^$1=" "$conf" 2>/dev/null; echo "$1=$2"; } > "$conf.new" && mv "$conf.new" "$conf" || die "cannot write $conf"
}

valid_interval() { [[ $1 =~ ^[1-9][0-9]*[mhd]$ ]]; }
valid_ceiling() { [[ $1 =~ ^([0-9]+(\.[0-9]+)?)$ ]] && [[ $1 =~ [1-9] ]]; }

# The provider's host and the variable its key goes in, from the model's name.
provider_of() {
  model=$(conf_get model anthropic/claude-sonnet-5-5)
  case ${model%%/*} in
    anthropic) host=api.anthropic.com key_var=ANTHROPIC_API_KEY ;;
    openai)    host=api.openai.com key_var=OPENAI_API_KEY ;;
    google)    host=generativelanguage.googleapis.com key_var=GOOGLE_API_KEY ;;
    mistral)   host=api.mistral.ai key_var=MISTRAL_API_KEY ;;
    *) host=${SPACETURTLE_MODEL_HOST:-}; key_var=MODEL_API_KEY
       [[ -n $host ]] || die "the launcher does not know the host of '${model%%/*}'. Set SPACETURTLE_MODEL_HOST to it." ;;
  esac
  [[ -n ${SPACETURTLE_MODEL_HOST:-} ]] && host=$SPACETURTLE_MODEL_HOST
  return 0
}

need_model_key() {
  [[ -s $key_file ]] || die "no model key. Put it in $key_file (mode 600), or run 'spaceturtle key' and paste it. The agent cannot read that file."
}

# The connector's zone must be running, with the supervisor in it.
need_connector() {
  zone_exists && "$sbx" ls 2>/dev/null | awk -v z="$zone" '$1 == z { ok = ($0 ~ /running/) } END { exit !ok }' \
    && in_zone 'pgrep -f "[t]oon up" >/dev/null' \
    || die "the connector's zone ($zone) is not running, so no session is started. Run 'spaceturtle start' first."
}

session() {
  local unattended=0
  case ${1:-} in
    "") ;;
    --unattended) unattended=1 ;;
    *) die "usage: spaceturtle session [--unattended]" ;;
  esac
  preflight
  need_model_key
  provider_of
  need_connector
  local args=(run --name "$agent_zone" --image "$agent_image"
    --allow-host "$host" --allow-host "localhost:$connector_port"
    -e "$key_var" -e TOON_AGENT_KEY -- docker-agent run --model "$model")
  if (( unattended )); then
    mkdir -p "$state_dir" && date -u +%Y-%m-%dT%H:%M:%SZ > "$state_dir/last-unattended" || die "cannot write $state_dir/last-unattended"
    args+=(--max-cost "$(conf_get ceiling 1)" --exec "Begin a session: read the waiting Requests and answer them, then do your daily work.")
  fi
  args+=("$agent_def")
  # The key reaches the process by name (-e), never as an argument.
  # The agent key's path, not the key, goes in the environment; the file is in the agent's zone.
  env "$key_var=$(<"$key_file")" "TOON_AGENT_KEY=${agent_key_path/\$HOME//home/agent}" "$sbx" "${args[@]}"
}

# --- the timer: a systemd user timer that runs an unattended session ---
write_timer() {
  local interval; interval=$(conf_get interval 6h)
  mkdir -p "$unit_dir" || die "cannot create $unit_dir"
  cat > "$unit_dir/spaceturtle.service" <<UNIT
[Unit]
Description=A spaceturtle session with nobody present

[Service]
Type=oneshot
ExecStart=$here/spaceturtle session --unattended
UNIT
  cat > "$unit_dir/spaceturtle.timer" <<UNIT
[Unit]
Description=Starts a spaceturtle session every $interval

[Timer]
OnBootSec=$interval
OnUnitActiveSec=$interval

[Install]
WantedBy=timers.target
UNIT
  "$systemctl_" --user daemon-reload || die "systemctl --user daemon-reload failed"
}

timer_on() {
  write_timer
  "$systemctl_" --user enable --now spaceturtle.timer || die "the timer could not be turned on"
  conf_set timer on
  say "the timer is on, every $(conf_get interval 6h)"
}

timer_off() {
  conf_set timer off
  [[ -e $unit_dir/spaceturtle.timer ]] && { "$systemctl_" --user disable --now spaceturtle.timer || die "the timer could not be turned off"; }
  say "the timer is off"
}

timer() {
  case ${1:-} in
    on) timer_on ;;
    off) timer_off ;;
    interval)
      valid_interval "${2:-}" || die "usage: spaceturtle timer interval <N>m|h|d, such as 6h"
      conf_set interval "$2"
      # A timer that is on is written again with the new interval.
      [[ $(conf_get timer on) == on ]] && timer_on || say "the interval is $2; the timer is off"
      ;;
    *) die "usage: spaceturtle timer on|off|interval <N>m|h|d" ;;
  esac
}

# `start` turns the timer on, unless the Observer turned it off.
step_timer() {
  [[ $(conf_get timer on) == on ]] && timer_on
  return 0
}

set_() {
  case ${1:-} in
    model)
      [[ ${2:-} =~ ^[A-Za-z0-9._:/-]+$ ]] || die "usage: spaceturtle set model <provider/model>"
      conf_set model "$2" ;;
    ceiling)
      valid_ceiling "${2:-}" || die "usage: spaceturtle set ceiling <dollars>, such as 1.50"
      conf_set ceiling "$2" ;;
    *) die "usage: spaceturtle set model|ceiling <value>" ;;
  esac
}

key() {
  local k
  [[ -t 0 ]] && printf 'Model key: ' >&2
  IFS= read -rs k; [[ -t 0 ]] && echo >&2
  [[ -n $k ]] || die "no key was given"
  mkdir -p "$(dirname "$key_file")" && (umask 077 && printf '%s\n' "$k" > "$key_file") || die "cannot write $key_file"
  say "the model key is saved in $key_file"
}

start() {
  preflight
  step_zone
  step_node
  step_faucet
  step_supervisor
  step_agentkey
  step_backup
  step_timer
  say "the connector's zone is running"
}

# --- the agent key: made and kept from outside the agent's zone ---
# The ids of the agent keys on the agent node's list, one per line.
agent_key_ids() {
  local doc
  doc=$(in_zone 'toon agent-key list --json') || return 1
  jq -r '(if type == "array" then . else (.keys // .agent_keys // []) end)[] | (.id // .public_key // empty)' <<<"$doc"
}

# The agent's zone must exist and run before a key can be placed in it. Takes its state.
ensure_agent_zone() {
  local s=$1
  if [[ $s == "not created" ]]; then
    mkdir -p "$state_dir/agent-workspace" || die "cannot create $state_dir/agent-workspace"
    "$sbx" create --name "$agent_zone" --template "$agent_image" shell "$state_dir/agent-workspace" || die "the agent's zone could not be created"
  elif [[ $s == stopped ]]; then
    "$sbx" start "$agent_zone" || die "the agent's zone could not be started"
  fi
}

# Makes a key in the connector's zone, where the home is. The private half is a file there
# until place_agent_key moves it.
make_agent_key() {
  in_zone 'rm -f /tmp/agent-key; umask 077; toon agent-key create --output /tmp/agent-key --json >/dev/null' \
    || { in_zone 'rm -f /tmp/agent-key'; die "toon agent-key create failed in the zone"; }
}

# Moves the private half to the agent's zone through a pipe, then deletes it from the connector's zone.
# The agent's zone is left stopped unless it was running, so `status` does not take it for a session.
place_agent_key() {
  local was; was=$(zone_state "$agent_zone")
  ensure_agent_zone "$was"
  if ! "$sbx" exec "$zone" sh -c 'cat /tmp/agent-key' | "$sbx" exec -i "$agent_zone" sh -c \
    'umask 077 && mkdir -p "$HOME/.config/toon-agent" && cat > "$HOME/.config/toon-agent/key.new" && [ -s "$HOME/.config/toon-agent/key.new" ] && mv -f "$HOME/.config/toon-agent/key.new" "$HOME/.config/toon-agent/key"'; then
    in_zone 'rm -f /tmp/agent-key'
    die "the agent key could not be placed in the agent's zone"
  fi
  in_zone 'rm -f /tmp/agent-key' || die "the agent key is placed, but its copy in the connector's zone could not be deleted"
  [[ $was == running ]] || "$sbx" stop "$agent_zone" || die "the agent key is placed, but the agent's zone could not be stopped"
}

revoke_agent_keys() { # ids
  local id
  for id in "$@"; do
    in_zone "toon agent-key revoke -- $(sh_quote "$id")" || die "toon agent-key revoke failed in the zone"
  done
}

# Exactly one agent key: made on the first run, never again. A run that finds a key on the
# list and no private half (the agent's zone was replaced) makes a new key, as replace does.
step_agentkey() {
  done_ agentkey && return
  local old
  old=$(agent_key_ids) || die "toon agent-key list failed in the zone"
  if [[ -z $old ]]; then
    say "making the agent key"
    make_agent_key
    place_agent_key
  elif in_zone 'test -s /tmp/agent-key'; then
    say "placing the agent key made earlier"
    place_agent_key
  else
    say "the agent key's private half is not in the agent's zone, so making a new key"
    make_agent_key
    place_agent_key
    revoke_agent_keys $old
  fi
  mark agentkey
}

# Keeps a document from carrying a private half, whatever field it is in.
scrub() { jq 'walk(if type == "object" then with_entries(select(.key | test("private|secret|seed"; "i") | not)) else . end)'; }

cmd_agent_key() {
  local sub=${1:-} old doc
  case $sub in
    show|replace|revoke) [[ $# -eq 1 ]] || die "usage: spaceturtle agent-key $sub" ;;
    limit) [[ $# -eq 2 ]] && valid_ceiling "$2" || die "usage: spaceturtle agent-key limit <amount>, such as 5" ;;
    *) die "usage: spaceturtle agent-key show | replace | revoke | limit <amount>" ;;
  esac
  preflight
  [[ $(zone_state) == running ]] || die "the connector's zone ($zone) is not running. Run 'spaceturtle start' first."
  command -v jq >/dev/null 2>&1 || die "jq is not installed."
  old=$(agent_key_ids) || die "toon agent-key list failed in the zone"
  case $sub in
    show)
      doc=$(in_zone 'toon agent-key list --json') || die "toon agent-key list failed in the zone"
      scrub <<<"$doc" || die "toon agent-key list gave a document that is not JSON"
      if [[ $(zone_state "$agent_zone") == running ]]; then
        # What is left today is read by the key itself, from the agent's zone; the key is not printed.
        "$sbx" exec "$agent_zone" sh -c "TOON_AGENT_KEY=$agent_key_path toon limit show --json" | scrub \
          || say "what is left today could not be read from the agent's zone"
      else
        say "what is left today is read from the agent's zone, which is not running. Start a session, or run 'spaceturtle session'."
      fi ;;
    replace)
      # The new key is made and placed before the old is revoked, so a failure leaves the old one working.
      say "making a new agent key"
      make_agent_key
      place_agent_key
      revoke_agent_keys $old
      mark agentkey
      say "the agent key is replaced. The wallet is as it was." ;;
    revoke)
      [[ -n $old ]] || { say "there is no agent key to revoke."; return 0; }
      revoke_agent_keys $old
      local astate; astate=$(zone_state "$agent_zone")
      if [[ $astate != "not created" ]]; then
        ensure_agent_zone "$astate"
        "$sbx" exec "$agent_zone" sh -c "rm -f $agent_key_path" \
          || die "the agent key is revoked, but its private half could not be deleted from the agent's zone"
        [[ $astate == running ]] || "$sbx" stop "$agent_zone" || say "the agent's zone could not be stopped again"
      fi
      mark agentkey
      say "the agent key is revoked: the agent's next order is refused. 'spaceturtle agent-key replace' makes another." ;;
    limit)
      [[ -n $old ]] || die "there is no agent key. Run 'spaceturtle start' or 'spaceturtle agent-key replace'."
      local id
      for id in $old; do
        in_zone "toon agent-key set --limit $(sh_quote "$2") -- $(sh_quote "$id")" || die "toon agent-key set failed in the zone"
      done
      say "the agent key's spending limit is $2" ;;
  esac
}

# The apps waiting, one JSON object per line: {name, image, since}. `toon status --json`
# lists an app, in an `apps` array, in the `pending` state with the image and the time it
# was asked for (seconds since the epoch or RFC 3339); a field it does not carry is left
# empty. Only objects in an `apps` array are apps, so nothing else that is pending counts.
# Dies when toon status fails, so callers must not run it in a pipeline or substitution
# whose failure they ignore.
waiting_apps() {
  local doc=${1-}
  [[ -n $doc ]] || doc=$(in_zone 'toon status --json') || die "toon status failed in the zone"
  jq -c '[.. | objects | .apps? | arrays | .[] | objects
    | select((.state // .status // "") == "pending" and (.name // "") != "")
    | {name, image: (.image // ""), since: (.requested_at // .asked_at // .since // .created_at // null)}]
    | unique_by(.name) | .[]' <<<"$doc" || die "toon status gave a document that is not JSON"
}

age() { # a time as seconds or RFC 3339 -> "3d", "5h", "12m", "40s", or "unknown"
  local t=$1 now secs
  [[ -n $t && $t != null ]] || { echo unknown; return; }
  [[ $t =~ ^[0-9]+$ ]] || t=$(date -d "$t" +%s 2>/dev/null) || { echo unknown; return; }
  now=$(date +%s); secs=$((now - t)); ((secs < 0)) && secs=0
  if ((secs >= 86400)); then echo "$((secs / 86400))d"
  elif ((secs >= 3600)); then echo "$((secs / 3600))h"
  elif ((secs >= 60)); then echo "$((secs / 60))m"
  else echo "${secs}s"; fi
}

cmd_waiting() {
  preflight
  local lines l name image since n=0
  lines=$(waiting_apps) || exit 1
  while IFS= read -r l; do
    [[ -n $l ]] || continue
    name=$(jq -r .name <<<"$l"); image=$(jq -r .image <<<"$l"); since=$(jq -r .since <<<"$l")
    printf '%s\t%s\t%s\n' "$name" "$image" "$(age "$since")"; n=$((n + 1))
  done <<<"$lines"
  ((n > 0)) || say "no app is waiting"
}

# approve|refuse <app> [reason]: only an app that is waiting is touched.
decide() {
  local verb=$1 app=${2:-} reason=${3:-} lines
  [[ -n $app && $app != -* ]] || die "usage: spaceturtle $verb <app>$([[ $verb == refuse ]] && echo ' [reason]')"
  preflight
  lines=$(waiting_apps) || exit 1
  jq -e --arg n "$app" 'select(.name == $n)' <<<"$lines" >/dev/null || die "$app is not waiting, so nothing was changed. 'spaceturtle waiting' lists what is."
  if [[ $verb == approve ]]; then
    in_zone "toon approve -- $(sh_quote "$app")" || die "toon approve failed in the zone"
    say "approved $app: it starts now, and an image that is not TOON's own runs under the sandboxed runtime"
  else
    in_zone "toon refuse ${reason:+--reason $(sh_quote "$reason") }-- $(sh_quote "$app")" || die "toon refuse failed in the zone"
    say "refused $app: it is discarded"
  fi
}

cmd_status() {
  preflight
  local lines last=never state astate doc network relay l url
  [[ -s $state_dir/last-unattended ]] && last=$(<"$state_dir/last-unattended")
  echo "timer: $(conf_get timer on), every $(conf_get interval 6h)"
  echo "last unattended session: $last"
  echo "model: $(conf_get model anthropic/claude-sonnet-5-5)"
  echo "ceiling: $(conf_get ceiling 1) per unattended session"
  state=$(zone_state)
  say "the connector's zone ($zone): $state"
  [[ $(zone_state "$agent_zone") == running ]] && astate="in a session" || astate=idle
  say "the agent's zone ($agent_zone): $astate"
  if [[ $state != running ]]; then
    say "the node's network, its apps and its relay cannot be read while the connector's zone is $state. Run 'spaceturtle start'."
    return 0
  fi
  if supervisor_running; then say "the supervisor is running"
  else say "the supervisor is not running. Run 'spaceturtle start'."; fi
  doc=$(in_zone 'toon status --json') || die "toon status failed in the zone"
  network=$(jq -r '.network // .agent_node.network // empty' <<<"$doc" 2>/dev/null)
  say "network: ${network:-cannot be read}"
  lines=$(jq -r '[.. | objects | .apps? | arrays | .[] | objects | select((.name // "") != "")
    | {name, state: (.state // .status // "")}] | unique_by(.name) | .[] | "\(.name)\t\(.state)"' <<<"$doc" 2>/dev/null)
  while IFS=$'\t' read -r l astate; do
    [[ -n $l ]] || continue
    if [[ $astate == running ]]; then say "app $l: running"; else say "app $l: not running (${astate:-unknown})"; fi
  done <<<"$lines"
  relay=$(jq -r 'first(.. | objects | (.relay_url?, (.relay? | if type == "string" then . elif type == "object" then (.url // .address // .ws_url) else empty end))
    | strings | select(length > 0)) // empty' <<<"$doc" 2>/dev/null)
  if [[ -z $relay ]]; then
    say "relay: the node reports no address, so it cannot be checked"
  else
    url=$relay
    case $url in ws://*) url=http://${url#ws://} ;; wss://*) url=https://${url#wss://} ;; *://*) ;; *) url=http://$url ;; esac
    if in_zone "curl -s -o /dev/null --max-time 5 --url $(sh_quote "$url")"; then say "relay: reachable at $relay"
    else say "relay: not reachable at $relay"; fi
  fi
  lines=$(waiting_apps "$doc") || exit 1
  say "$(grep -c . <<<"$lines") app(s) waiting for approval"
}

# Stops everything and loses nothing: the timer's unit (its setting stays), a session in the
# agent's zone, then the connector's zone. `start` brings it back.
cmd_stop() {
  preflight
  local state; state=$(zone_state)
  if [[ $state == "not created" ]]; then
    say "there is no connector's zone, so there is nothing to stop."
    return 0
  fi
  if [[ -e $unit_dir/spaceturtle.timer ]]; then
    "$systemctl_" --user stop spaceturtle.timer || die "the timer could not be stopped"
  fi
  if [[ $(zone_state "$agent_zone") == running ]]; then
    "$sbx" stop "$agent_zone" || die "the session in the agent's zone ($agent_zone) could not be stopped"
  fi
  if [[ $state == running ]]; then
    "$sbx" stop "$zone" || die "the connector's zone ($zone) could not be stopped"
  fi
  say "stopped. The wallet, the passphrase and the timer's setting are as they were. Run 'spaceturtle start' to bring it back."
}

cmd_backup() {
  preflight
  [[ $(zone_state) == running ]] || die "the connector's zone ($zone) is not running, so there is nothing to back up. Run 'spaceturtle start' first."
  make_backup || die "the backup failed"
}

# Replaces the connector's zone with one from the newest image. The wallet's storage stays
# as it was. The passphrase travels through memory: out of the old zone on the standard
# output of sbx exec, into the new one on the standard input of sbx exec -i.
cmd_upgrade() {
  preflight
  local state pass
  state=$(zone_state)
  [[ $state != "not created" ]] || die "there is no connector's zone yet. Run 'spaceturtle start' first."
  [[ $state == running ]] || die "the connector's zone ($zone) is $state. Run 'spaceturtle start' first; nothing was changed."
  say "making a fresh backup before anything is removed"
  make_backup || die "the backup failed, so nothing was changed."
  pass=$("$sbx" exec "$zone" sh -c 'cat "$HOME/.config/toon-passphrase"') && [[ -n $pass ]] \
    || die "the passphrase could not be read out of the old zone, so nothing was changed."
  say "replacing the connector's zone ($zone)"
  if [[ $(zone_state "$agent_zone") != "not created" ]]; then
    "$sbx" rm --force "$agent_zone" || die "the agent's zone ($agent_zone) could not be removed"
  fi
  "$sbx" rm --force "$zone" || die "the old connector's zone could not be removed"
  create_zone
  # The node, the faucet and the backup belong to the wallet, which is kept; the rest belong to the zone.
  rm -f "$marks/rule" "$marks/zone"
  step_zone
  if ! printf '%s\n' "$pass" | "$sbx" exec -i "$zone" sh -c 'mkdir -p "$HOME/.config" && umask 077 && cat > "$HOME/.config/toon-passphrase" && [ -s "$HOME/.config/toon-passphrase" ]'; then
    pass=
    die "the new zone ($zone) is made, but the passphrase could not be placed in it. The backup at $backup_dir/wallet-backup is the way back."
  fi
  pass=
  step_node
  step_faucet
  step_supervisor
  # The agent's zone, and the private half in it, is gone: a key on the list is made again; a revoked one is not.
  local keys; keys=$(agent_key_ids) || die "toon agent-key list failed in the zone"
  [[ -z $keys ]] || rm -f "$marks/agentkey"
  step_agentkey
  step_backup
  say "the connector's zone is upgraded and running"
}

# Removes spaceturtle from the machine, but not the wallet's storage nor the backup directory.
cmd_remove() {
  local delete=0 arg answer z
  for arg in "$@"; do
    case $arg in
      --delete-wallet) delete=1 ;;
      *) die "usage: spaceturtle remove [--delete-wallet]" ;;
    esac
  done
  preflight
  if (( delete )); then
    say "--delete-wallet deletes the wallet's storage, $data_dir. Without the backup the wallet cannot be opened again, and funds in it are lost."
    printf 'spaceturtle: type "delete" to go on: '
    IFS= read -r answer || answer=
    if [[ $answer != delete ]]; then
      echo
      say "not confirmed. Nothing was changed."
      return 1
    fi
  fi
  if [[ $(zone_state) == running ]]; then
    say "the passphrase goes with the connector's zone, and the wallet's storage cannot be opened without the backup."
    printf 'spaceturtle: make a fresh backup first? [Y/n] '
    IFS= read -r answer || answer=
    case $answer in
      n|N|no|No|NO) say "no fresh backup was made" ;;
      *) make_backup || die "the backup failed, so nothing was removed. Answer n to remove without it." ;;
    esac
  fi
  for z in "$agent_zone" "$zone"; do
    [[ $(zone_state "$z") == "not created" ]] || "$sbx" rm --force "$z" || die "the zone $z could not be removed"
  done
  if [[ -e $unit_dir/spaceturtle.timer ]]; then
    "$systemctl_" --user disable --now spaceturtle.timer || die "the timer could not be turned off"
  fi
  rm -f "$unit_dir/spaceturtle.timer" "$unit_dir/spaceturtle.service"
  "$systemctl_" --user daemon-reload
  rm -rf "$marks"
  rm -f "$state_dir/last-unattended" "$conf" "$conf.new" "$key_file"
  rmdir "$state_dir" "$config_dir" "$(dirname "$key_file")" 2>/dev/null
  if (( delete )); then
    [[ -n $data_dir && $data_dir != / ]] || die "will not delete '$data_dir'"
    rm -rf "$data_dir" || die "cannot delete $data_dir"
    say "the wallet's storage ($data_dir) is deleted."
  else
    say "the wallet's storage is kept at $data_dir"
  fi
  say "the backup directory is kept at $backup_dir. Nothing deletes it."
  say "spaceturtle is removed from this machine."
}

case ${1:-} in
  start) start ;;
  mainnet) shift; mainnet "$@" ;;
  session) shift; session "$@" ;;
  timer) shift; timer "$@" ;;
  set) shift; set_ "$@" ;;
  key) key ;;
  waiting) cmd_waiting ;;
  approve) decide approve "${2:-}" ;;
  refuse) decide refuse "${2:-}" "${3:-}" ;;
  status) cmd_status ;;
  agent-key) shift; cmd_agent_key "$@" ;;
  stop) [[ $# -eq 1 ]] || die "usage: spaceturtle stop"; cmd_stop ;;
  upgrade) [[ $# -eq 1 ]] || die "usage: spaceturtle upgrade"; cmd_upgrade ;;
  backup) [[ $# -eq 1 ]] || die "usage: spaceturtle backup"; cmd_backup ;;
  remove) shift; cmd_remove "$@" ;;
  *) die "usage: spaceturtle start | stop | upgrade | backup | remove [--delete-wallet] | mainnet [--keep-limit] | session | timer | set | key | status | waiting | approve <app> | refuse <app> [reason] | agent-key show|replace|revoke|limit <amount>" ;;
esac
