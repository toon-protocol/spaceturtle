#!/bin/bash
# Checks an agent definition for docker-agent against the rules that keep the agent away
# from the money (ADR 0003), and the one that keeps the published file the checked one.
# Needs bash, jq and yq (mikefarah's).
# Usage: tests/check-agent [definition.yaml]   (default: agent/spaceturtle.yaml)
# Prints one line per broken rule, "FAIL <rule>: <agent>[/<tool>]: <why>", and exits 1.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
def=${1:-$root/agent/spaceturtle.yaml}
command -v yq >/dev/null || { echo "FAIL readable: yq (mikefarah's) is not installed"; exit 1; }
json=$(yq -o=json '.' "$def") || { echo "FAIL readable: $def is not YAML"; exit 1; }
fails=0
fail() { echo "FAIL $1: $2"; fails=$((fails + 1)); }

# Prints the names of the variables the command expands outside double quotes.
unquoted_vars() {
  local s=$1 i c q= name n=${#1}
  for ((i = 0; i < n; i++)); do
    c=${s:i:1}
    if [[ $q == "'" ]]; then [[ $c == "'" ]] && q=; continue; fi
    if [[ $c == '\' ]]; then ((i++)); continue; fi
    if [[ $c == "'" && -z $q ]]; then q="'"; continue; fi
    if [[ $c == '"' ]]; then [[ $q == '"' ]] && q= || q='"'; continue; fi
    if [[ $c == '$' ]]; then
      name=
      if [[ ${s:i+1:1} == '{' ]]; then [[ ${s:i+2} =~ ^[A-Za-z_][A-Za-z0-9_]* ]] && name=${BASH_REMATCH[0]}
      else [[ ${s:i+1} =~ ^[A-Za-z_][A-Za-z0-9_]* ]] && name=${BASH_REMATCH[0]}; fi
      [[ -z $q && -n $name ]] && echo "$name"
    fi
  done
}

forbidden='(^|[^[:alnum:]_.-])["'"'"']?toon["'"'"']?([[:space:]]+-[^[:space:]]+)*[[:space:]]+(limit[[:space:]]+set|agent-key|wallet|channel[[:space:]]+withdraw|channel[[:space:]]+open|create|init|approve|refuse)([^[:alnum:]_-]|$)'

while IFS= read -r agent; do
  jqa() { jq -r --arg a "$agent" --arg n "${2-}" ".agents[\$a] | $1" <<<"$json"; }
  # The agent's toolsets: its own, then the shared ones it names in use_toolsets.
  toolsets=$(jq -c --arg a "$agent" '. as $r | .agents[$a] | (.toolsets // []) + [(.use_toolsets // [])[] | $r.toolsets[.] // empty]' <<<"$json")
  jqt() { jq -r --arg n "${2-}" "$1" <<<"$toolsets"; }

  [[ $(jq '.runtime.sandbox == true' <<<"$json") == true ]] || fail sandbox "$agent: the definition does not require the agent's sandbox (runtime.sandbox: true)"

  # A string that is "local" or a URL is a source; any other string only names a skill.
  while IFS= read -r src; do
    [[ $src == local || $src == http://* || $src == https://* ]] || continue
    [[ $src =~ ^https://github\.com/[^/?#]+/[^/?#]+(/tree/[0-9a-f]{40}(/[^?#]*)?|\?([^#]*&)?ref=[0-9a-f]{40}(&[^#]*)?)$ ]] ||
      fail skill-pinned "$agent: skill source '$src' is not pinned to a commit (https://github.com/<owner>/<repo>/tree/<40 hex>/<dir>)"
  done < <(jqa '(.skills // []) | if type == "array" then .[] | strings elif . == true then "local" else empty end')

  n=$(jqt 'length')
  for ((t = 0; t < n; t++)); do
    type=$(jqt ".[$t].type")
    case $type in
      shell|bash) fail no-shell-tool "$agent/$type: a shell tool gives the agent any command" ;;
      filesystem|file)
        dirs=$(jqt ".[$t].allow_list // [] | .[]")
        [[ -n $dirs ]] || fail file-scope "$agent/$type: no allow_list, so the file tool reaches everything"
        while IFS= read -r d; do
          [[ -z $d ]] && continue
          if [[ $d == *..* || ! $d =~ ^~/(\.config|\.local/state)/spaceturtle(/[^/]+)*/?$ ]]; then
            fail file-scope "$agent/$type: '$d' is outside spaceturtle's own configuration and state directories"
          fi
        done <<<"$dirs" ;;
      script)
        while IFS= read -r name; do
          cmd=$(jqt ".[$t].shell[\$n].cmd // \"\"" "$name")
          args=$(jqt ".[$t].shell[\$n].args // {} | keys[]" "$name")
          flat=$(tr '\n' ' ' <<<"$cmd")
          [[ $flat =~ $forbidden ]] && fail forbidden-command "$agent/$name: runs 'toon ${BASH_REMATCH[4]}', which the agent key's scope does not allow"
          [[ $flat =~ (^|[^[:alnum:]_.-])[\"\']?toon[\"\']?([[:space:]]+-[^[:space:]]+)*[[:space:]]+[\"\'\$] ]] && fail forbidden-command "$agent/$name: the toon subcommand is not fixed, so it could be any command"
          used=$(unquoted_vars "$cmd" | sort -u)
          while IFS= read -r a; do
            [[ -n $a ]] && grep -qx "$a" <<<"$args" && fail quoted-args "$agent/$name: argument '$a' is used unquoted, so it could add a flag"
          done <<<"$used"
        done < <(jqt ".[$t].shell // {} | keys[]") ;;
    esac
  done
done < <(jq -r '.agents // {} | keys[]' <<<"$json")

[[ $(jq '.agents // {} | length' <<<"$json") -gt 0 ]] || fail agent "no agent is defined"

# docker-agent publishes the file as written only when it names its version and no agent
# has an instruction_file; otherwise it publishes its own rewriting of the definition,
# which is not the file these rules were checked on.
[[ $(jq '.version | type == "string" and . != ""' <<<"$json") == true ]] ||
  fail published-as-written "the definition: no version as a string (version: \"16\"), so docker-agent would publish a rewritten file"
while IFS= read -r agent; do
  fail published-as-written "$agent: instruction_file is inlined when published, so docker-agent would publish a rewritten file"
done < <(jq -r '.agents // {} | to_entries[] | select(.value.instruction_file | . != null and . != "" and . != []) | .key' <<<"$json")
[[ $fails -eq 0 ]] && echo "ok   agent definition: every rule holds"
[[ $fails -eq 0 ]]
