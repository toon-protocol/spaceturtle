#!/bin/bash
# Checks an agent definition for docker-agent against the rules that keep the agent away
# from the money (ADR 0003). Needs bash, jq and yq (mikefarah's).
# Usage: tests/check-agent [definition.yaml]   (default: agent/spaceturtle.yaml)
# Prints one line per broken rule, "FAIL <rule>: <agent>[/<tool>]: <why>", and exits 1.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
def=${1:-$root/agent/spaceturtle.yaml}
json=$(yq -o=json '.' "$def") || { echo "FAIL readable: $def is not YAML"; exit 1; }
fails=0
fail() { echo "FAIL $1: $2"; fails=$((fails + 1)); }

# Prints the names of the variables the command expands outside double quotes.
unquoted_vars() {
  local s=$1 i c q= name n=${#1}
  for ((i = 0; i < n; i++)); do
    c=${s:i:1}
    if [[ $q == "'" ]]; then [[ $c == "'" ]] && q=; continue; fi
    if [[ $c == '\' ]]; then ((i++)); continue; fi
    if [[ $c == "'" && -z $q ]]; then q="'"; continue; fi
    if [[ $c == '"' ]]; then [[ $q == '"' ]] && q= || q='"'; continue; fi
    if [[ $c == '$' ]]; then
      name=
      if [[ ${s:i+1:1} == '{' ]]; then [[ ${s:i+2} =~ ^[A-Za-z_][A-Za-z0-9_]* ]] && name=${BASH_REMATCH[0]}
      else [[ ${s:i+1} =~ ^[A-Za-z_][A-Za-z0-9_]* ]] && name=${BASH_REMATCH[0]}; fi
      [[ -z $q && -n $name ]] && echo "$name"
    fi
  done
}

forbidden='(^|[^[:alnum:]_.-])toon[[:space:]]+(limit[[:space:]]+set|wallet|channel[[:space:]]+withdraw|channel[[:space:]]+open|create|init)([^[:alnum:]_-]|$)'

while IFS= read -r agent; do
  jqa() { jq -r --arg a "$agent" ".agents[\$a] | $1" <<<"$json"; }

  [[ $(jqa '.sandbox') == true ]] || fail sandbox "$agent: the definition does not require the agent's sandbox (sandbox: true)"

  while IFS= read -r src; do
    [[ $src =~ @[0-9a-f]{40}$ ]] || fail skill-pinned "$agent: skill source '$src' is not pinned to a commit (@<40 hex>)"
  done < <(jqa '(.skills // [])[] | if type == "object" then .source else . end')

  n=$(jqa '(.toolsets // []) | length')
  for ((t = 0; t < n; t++)); do
    type=$(jqa ".toolsets[$t].type")
    case $type in
      shell|bash) fail no-shell-tool "$agent/$type: a shell tool gives the agent any command" ;;
      filesystem)
        dirs=$(jqa ".toolsets[$t].allowed_directories // [] | .[]")
        [[ -n $dirs ]] || fail file-scope "$agent/filesystem: no allowed_directories, so the file tool reaches everything"
        while IFS= read -r d; do
          [[ -z $d ]] && continue
          if [[ $d == *..* || ! $d =~ ^(~|\$HOME)/(\.config|\.local/state)/spaceturtle(/[^/]+)*/?$ ]]; then
            fail file-scope "$agent/filesystem: '$d' is outside spaceturtle's own configuration and state directories"
          fi
        done <<<"$dirs" ;;
      script)
        while IFS= read -r name; do
          cmd=$(jqa ".toolsets[$t].shell[\"$name\"].cmd // \"\"")
          args=$(jqa ".toolsets[$t].shell[\"$name\"].args // {} | keys[]")
          flat=$(tr '\n' ' ' <<<"$cmd")
          [[ $flat =~ $forbidden ]] && fail forbidden-command "$agent/$name: runs 'toon ${BASH_REMATCH[2]}', which the agent key's scope does not allow"
          [[ $flat =~ (^|[^[:alnum:]_.-])toon[[:space:]]+[\"\'\$] ]] && fail forbidden-command "$agent/$name: the toon subcommand is not fixed, so it could be any command"
          used=$(unquoted_vars "$cmd" | sort -u)
          while IFS= read -r a; do
            [[ -n $a ]] && grep -qx "$a" <<<"$args" && fail quoted-args "$agent/$name: argument '$a' is used unquoted, so it could add a flag"
          done <<<"$used"
        done < <(jqa ".toolsets[$t].shell // {} | keys[]") ;;
    esac
  done
done < <(jq -r '.agents // {} | keys[]' <<<"$json")

[[ $(jq '.agents // {} | length' <<<"$json") -gt 0 ]] || fail agent "no agent is defined"
[[ $fails -eq 0 ]] && echo "ok   agent definition: every rule holds"
[[ $fails -eq 0 ]]
