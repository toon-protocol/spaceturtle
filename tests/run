#!/bin/bash
# Runs relay-events against a stub `toon` and `curl` in a temporary home.
# Needs only bash and jq. Usage: tests/run
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
fails=0 count=0
tmps=()
trap 'rm -rf "${tmps[@]}"' EXIT

new_env() {
  tmp=$(mktemp -d); tmps+=("$tmp")
  export HOME=$tmp/home SPACETURTLE_CONFIG_DIR=$tmp/config
  mkdir -p "$HOME/.local/bin" "$SPACETURTLE_CONFIG_DIR" "$tmp/bin"
  export SPACETURTLE_TOON=$tmp/bin/toon
  export STUB_DIR=$tmp/stub; mkdir -p "$STUB_DIR"
  # A curl that prints the NIP-11 document in $STUB_DIR/nip11, or fails.
  cat > "$HOME/.local/bin/curl" <<'STUB'
#!/bin/bash
[[ -r $STUB_DIR/nip11 ]] && cat "$STUB_DIR/nip11"
STUB
  chmod +x "$HOME/.local/bin/curl"
}

# A toon that answers from files in $STUB_DIR; the file for `toon event query`
# depends on the filter's kinds.
install_toon() {
  cat > "$SPACETURTLE_TOON" <<'STUB'
#!/bin/bash
echo "$*" >> "$STUB_DIR/calls"
case "$1 $2" in
  "status --json") cat "$STUB_DIR/status" ;;
  "relay config") cat "$STUB_DIR/config" ;;
  "relay subscriptions")
    case "$*" in
      *--incoming*) echo '{"error":"not sold"}' ;;
      *) [[ -r $STUB_DIR/held ]] && cat "$STUB_DIR/held" || exit 1 ;;
    esac ;;
  "peer list"|"channel list"|"route list"|"limit show"|"logs --json")
    f="$STUB_DIR/$1$2"; [[ -r $f ]] && cat "$f" || exit 1 ;;
  "event query")
    case "$*" in
      *'"authors"'*) if [[ -r $STUB_DIR/agent-events ]]; then cat "$STUB_DIR/agent-events"; else echo '{"events":[]}'; fi ;;
      *'"kinds":[0]'*) cat "$STUB_DIR/profiles" ;;
      *'"kinds":[3]'*) cat "$STUB_DIR/follows" ;;
      *) cat "$STUB_DIR/events" ;;
    esac ;;
  *) echo "unexpected toon $*" >&2; exit 1 ;;
esac
STUB
  chmod +x "$SPACETURTLE_TOON"
}

running_relay() {
  echo '{"agent_node":{"toon_apps":[{"apps":[{"name":"relay","running":true,"read_address":"127.0.0.1:7100"}]}]}}' > "$STUB_DIR/status"
  echo '{"relay":{"name":"Shelly"}}' > "$STUB_DIR/config"
}

check() { # name, jq expression that must be true of $out
  count=$((count + 1))
  if jq -e "$2" <<<"$out" >/dev/null 2>&1; then echo "ok   $1"
  else echo "FAIL $1"; echo "     expression: $2"; echo "     document:   $out"; fails=$((fails + 1)); fi
}

OFFLINE='.online == false and .name == "" and .self == "" and .subscribers == null and .profiles == [] and .follows == [] and .activity == [] and .last_active == null and .events == [] and .node == {ilp_address: "", connector: ""}'
pk=$(printf 'a%.0s' {1..64}); other=$(printf 'b%.0s' {1..64})

# --- no toon
new_env
out=$(SPACETURTLE_TOON=$tmp/bin/missing "$root/relay-events")
check "no toon: the offline document" "$OFFLINE"

# --- relay not running
new_env; install_toon
echo '{"agent_node":{"toon_apps":[{"apps":[{"name":"relay","running":false}]}]}}' > "$STUB_DIR/status"
out=$("$root/relay-events")
check "relay not running: the offline document" "$OFFLINE"
! grep -q "event query" "$STUB_DIR/calls" || { echo "FAIL relay not running: queried the relay"; fails=$((fails + 1)); }

# --- a relay with events
new_env; install_toon; running_relay
echo "{\"events\":[{\"id\":\"e1\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":10,\"tags\":[],\"content\":\"hi\"},{\"id\":\"e2\",\"pubkey\":\"$other\",\"kind\":30023,\"created_at\":5,\"tags\":[],\"content\":\"long form\"}]}" > "$STUB_DIR/events"
echo "{\"events\":[{\"id\":\"p1\",\"pubkey\":\"$pk\",\"kind\":0,\"created_at\":1,\"tags\":[],\"content\":\"{\\\"name\\\":\\\"Shelly\\\"}\"}]}" > "$STUB_DIR/profiles"
echo "{\"events\":[{\"id\":\"f1\",\"pubkey\":\"$pk\",\"kind\":3,\"created_at\":2,\"tags\":[[\"p\",\"$other\"]],\"content\":\"\"}]}" > "$STUB_DIR/follows"
echo '{"name":"Shelly relay","ilp_address":"g.toon.shelly","connector":"https://node.example:8080"}' > "$STUB_DIR/nip11"
out=$("$root/relay-events" 25)
check "events: online, with the relay's name" '.online == true and .name == "Shelly"'
check "events: every event the relay returned" '[.events[].id] == ["e1","e2"]'
! grep -q '"limit":25.*"kinds"\|"kinds".*"limit":25' "$STUB_DIR/calls" || { echo "FAIL events: the feed query is limited to kinds"; fails=$((fails + 1)); }
check "events: profiles and follow lists" '(.profiles | length) == 1 and (.follows[0].tags == [["p","'"$other"'"]])'
grep -q '"limit":25' "$STUB_DIR/calls" || { echo "FAIL events: limit not passed"; fails=$((fails + 1)); }
check "events: ILP and connector come from NIP-11" '.node == {ilp_address: "g.toon.shelly", connector: "https://node.example:8080"}'
check "events: no public key file, no self" '.self == ""'
check "events: without a key the agent is unknown, and the Network holds every event" '.activity == [] and .last_active == null and ([.events[].id] == ["e1","e2"])'
check "events: subscribers null while not sold" '.subscribers == null'
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
out=$("$root/relay-events")
check "events: the public key file marks the agent" ".self == \"$pk\""
check "activity: the agent's events, apart from the Network's" '[.activity[].id] == ["e1"] and ([.events[].id] == ["e2"])'
check "activity: the time of the latest activity" '.last_active == 10'
echo "{\"events\":[{\"id\":\"e0\",\"pubkey\":\"$pk\",\"kind\":7,\"created_at\":20,\"tags\":[[\"e\",\"e2\"],[\"p\",\"$other\"]],\"content\":\"+\"}]}" > "$STUB_DIR/agent-events"
out=$("$root/relay-events")
check "activity: an agent event beyond the feed's limit is found, and says what it refers to" '[.activity[].id] == ["e0","e1"] and .activity[0].refers_to == "e2" and .activity[1].refers_to == null and .last_active == 20'
check "activity: the Network excludes the agent's events" '[.events[].id] == ["e2"]'
echo "{\"events\":[{\"id\":\"e0\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":5,\"tags\":[[\"e\",\"p1\",\"\",\"reply\"],[\"e\",\"r1\",\"\",\"root\"]],\"content\":\"re\"}]}" > "$STUB_DIR/agent-events"
out=$("$root/relay-events")
check "activity: newest first, wherever each event was found" '[.activity[].id] == ["e1","e0"] and .last_active == 10'
check "activity: a reply refers to the event marked reply, not the root" '.activity[1].refers_to == "p1"'
rm "$STUB_DIR/agent-events"
echo "{\"events\":[{\"id\":\"e2\",\"pubkey\":\"$other\",\"kind\":1,\"created_at\":5,\"tags\":[],\"content\":\"x\"}]}" > "$STUB_DIR/events"
out=$("$root/relay-events")
check "activity: an agent that has done nothing" '.self != "" and .activity == [] and .last_active == null'
echo "{\"events\":[{\"id\":\"e1\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":10,\"tags\":[],\"content\":\"hi\"},{\"id\":\"e2\",\"pubkey\":\"$other\",\"kind\":30023,\"created_at\":5,\"tags\":[],\"content\":\"long form\"}]}" > "$STUB_DIR/events"
echo '{"ilp_address":5,"connector":"https://node.example:8080"}' > "$STUB_DIR/nip11"
out=$("$root/relay-events")
check "events: a non-string NIP-11 field leaves the other" '.node == {ilp_address: "", connector: "https://node.example:8080"}'
echo "not a key" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
out=$("$root/relay-events")
check "events: a malformed public key file is ignored" '.self == "" and .online == true'
rm "$STUB_DIR/nip11"
out=$("$root/relay-events")
check "events: without NIP-11 the feed still works" '.online == true and (.events | length) == 2 and .node.ilp_address == ""'
! grep -q "wallet" "$STUB_DIR/calls" || { echo "FAIL ran a wallet command"; fails=$((fails + 1)); }

# --- the node's state
new_env; install_toon
echo '{"agent_node":{"supervisor":{"running":true,"restarts":1},"connector":{"running":false},"toon_apps":[{"apps":[{"name":"relay","running":true,"read_address":"127.0.0.1:7100","restarts":2},{"name":"chat","running":false}]}]}}' > "$STUB_DIR/status"
echo '{"relay":{"name":"Shelly","prices":{"write":"10"},"blocklist":["badkey"]}}' > "$STUB_DIR/config"
echo '{"events":[]}' | tee "$STUB_DIR/events" "$STUB_DIR/profiles" > "$STUB_DIR/follows"
echo '{"peers":[{"id":"alice","direction":"outbound","status":"connected"}]}' > "$STUB_DIR/peerlist"
echo '{"channels":[{"peer":"alice","direction":"outbound","status":"open","collateral":500}]}' > "$STUB_DIR/channellist"
echo '{"routes":[{"prefix":"g.alice","peer":"alice","price":3}]}' > "$STUB_DIR/routelist"
echo '{"per_command":"100","per_day":"1000","remaining_today":"640"}' > "$STUB_DIR/limitshow"
echo '{"subscriptions":["wss://other"]}' > "$STUB_DIR/held"
printf '{"lines":[%s]}\n' "$(jq -cn '[range(30) | "line \(.)"] | map(tojson) | join(",")' -r)" > "$STUB_DIR/logs--json"
out=$("$root/relay-events")
check "state: supervisor, connector and each app with restarts" '.state.status == {supervisor: {running: true, restarts: 1}, connector: {running: false, restarts: 0}, apps: [{name:"relay",running:true,restarts:2},{name:"chat",running:false,restarts:0}]}'
check "state: relay name, prices and blocklist" '.state.relay == {name:"Shelly", prices:[{name:"write",price:"10"}], blocklist:["badkey"]}'
check "state: peers" '.state.peers == [{id:"alice",direction:"outbound",status:"connected"}]'
check "state: channels with collateral" '.state.channels == [{peer:"alice",direction:"outbound",status:"open",collateral:"500"}]'
check "state: routes with price" '.state.routes == [{prefix:"g.alice",peer:"alice",price:"3"}]'
check "state: spending limits and what remains" '.state.limits == {per_command:"100",per_day:"1000",remaining_today:"640"}'
check "state: subscriptions held, and incoming unavailable while not sold" '.state.subscriptions == {held:["wss://other"], incoming:null}'
check "state: the last 20 log lines" '(.state.logs | length) == 20 and .state.logs[19] == "line 29"'
grep -c "subscriptions --incoming" "$STUB_DIR/calls" | grep -qx 1 || { echo "FAIL state: asked for incoming subscriptions more than once"; fails=$((fails + 1)); }
rm "$STUB_DIR/channellist"; echo '{"error":"no channels"}' > "$STUB_DIR/routelist"
out=$("$root/relay-events")
check "state: a failing command and an error document are unavailable, the rest shows" '.state.channels == null and .state.routes == null and (.state.peers | length) == 1 and .state.limits.per_day == "1000" and .state.status.supervisor.running == true'
echo '{"lines":"not a list"}' > "$STUB_DIR/logs--json"; echo '{"peers":["alice"]}' > "$STUB_DIR/peerlist"
out=$("$root/relay-events")
check "state: an answer of a shape not understood is unavailable, the rest shows" '.state.logs == null and .state.peers == null and .state.limits.per_day == "1000" and .state.relay.name == "Shelly"'
printf '%s\n' '"line a"' '"line b"' > "$STUB_DIR/logs--json"
out=$("$root/relay-events")
check "state: logs printed one JSON value per line" '.state.logs == ["line a","line b"]'
for bad in wallet "wallet balance" "up" "channel open" "limit set" "route add"; do
  ! grep -q "^$bad" "$STUB_DIR/calls" || { echo "FAIL state: ran toon $bad"; fails=$((fails + 1)); }
done
rm "$STUB_DIR/status"
out=$("$root/relay-events")
check "state: a failing status is unavailable, the rest shows" '.state.status == null and .state.relay.name == "Shelly" and .state.limits.per_day == "1000" and .online == false'
echo '{}' > "$STUB_DIR/status"
out=$("$root/relay-events")
check "state: no agent node, no state" '.state == null and .online == false'

# --- the parts of each kind
new_env; install_toon; running_relay
echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
ev() { jq -cn --argjson k "$1" --arg c "$2" --argjson t "$3" '{id:("k"+($k|tostring)+$c[0:3]),pubkey:"'"$pk"'",kind:$k,created_at:1,tags:$t,content:$c}'; }
{
  echo '{"events":['
  ev 0 '{"name":"Shelly","about":"turtle"}' '[]'; echo ,
  ev 1 'hello' '[]'; echo ,
  ev 1 'a reply' '[["e","'"$other"'"]]'; echo ,
  ev 3 '' '[["p","'"$other"'"],["p","'"$pk"'"]]'; echo ,
  ev 5 'mistake' '[["e","'"$other"'"]]'; echo ,
  ev 6 '' '[["e","'"$other"'"]]'; echo ,
  ev 7 '+' '[["e","'"$other"'"]]'; echo ,
  ev 16 '' '[["e","'"$other"'"]]'; echo ,
  ev 1111 'a comment' '[["e","'"$other"'"]]'; echo ,
  ev 30023 'long text' '[["title","A Title"],["summary","Sum"],["r","https://a.example/x"],["r","javascript:alert(1)"]]'; echo ,
  ev 30817 'draft text' '[["d","nip-x"],["title","Draft"]]'; echo ,
  ev 31337 'raw' '[["alt","A thing"],["x","y","z"]]'; echo ,
  ev 31338 'raw2' '[]'; echo ,
  ev 31339 'raw3' '[["k","v"],["e","'"$other"'"]]'
  echo ']}'
} > "$STUB_DIR/events"
out=$("$root/relay-events")
P() { echo ".events[] | select(.kind == $1) | .parts | $2"; }
check "parts 0: name and about" "$(P 0 '.label == "updated profile" and .title == "Shelly" and .summary == "turtle" and .body == ""')"
check "parts 1: a note" "$(P 1 'select(.ref == "") | .label == "" and .body == "hello"')"
check "parts 1: a reply refers to its event" "$(P 1 'select(.body == "a reply") | .label == "replied" and .ref == "'"$other"'"')"
check "parts 3: follows counted" "$(P 3 '.label == "updated follows" and .body == "2 followed"')"
check "parts 5: deletion refers to its target" "$(P 5 '.label == "deleted" and .ref == "'"$other"'" and .summary == "1 deleted"')"
check "parts 6: repost" "$(P 6 '.label == "reposted" and .ref == "'"$other"'" and .body == ""')"
check "parts 7: reaction" "$(P 7 '.label == "reacted" and .body == "󰋑"')"
check "parts 16: generic repost" "$(P 16 '.label == "reposted" and .ref == "'"$other"'"')"
check "parts 1111: comment" "$(P 1111 '.label == "commented" and .body == "a comment"')"
check "parts 30023: article, only http(s) links" "$(P 30023 '.label == "published" and .title == "A Title" and .summary == "Sum" and .links == ["https://a.example/x"]')"
check "parts 30817: NIP draft" "$(P 30817 '.label == "drafted" and .title == "Draft" and .body == "draft text"')"
check "parts unknown with alt: alt, kind, tags, content" "$(P 31337 '.label == "kind 31337" and .title == "A thing" and .summary == "alt A thing, x y z" and .body == "raw"')"
check "parts unknown without alt: kind, content" "$(P 31338 '.label == "kind 31338" and .title == "" and .summary == "" and .body == "raw2"')"
check "parts unknown without alt, with tags: kind, tags, content" "$(P 31339 '.label == "kind 31339" and .title == "" and .summary == "k v, e '"$other"'" and .body == "raw3"')"
check "parts: every event has all the parts" '[.events[].parts | keys == ["body","label","links","ref","summary","title"]] | all'

# --- malformed tags and content cost only the odd part, never the feed
new_env; install_toon; running_relay
echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
echo '{"events":[
  {"id":"m3","kind":3,"tags":["p",{"a":1}],"content":""},
  {"id":"m5","kind":5,"tags":[{"a":1},"e"],"content":""},
  {"id":"m1","kind":1,"tags":"oops","content":"still here"},
  {"id":"m7","kind":7,"tags":[],"content":null}
]}' > "$STUB_DIR/events"
out=$("$root/relay-events")
check "malformed: every event survives" '[.events[].id] == ["m3","m5","m1","m7"]'
check "malformed: no tags counted" '[.events[] | select(.id == "m3" or .id == "m5") | .parts | .body, .summary] == ["0 followed","","","0 deleted"]'
check "malformed: a note with string tags" '.events[] | select(.id == "m1") | .parts | .body == "still here" and .ref == "" and .links == []'
check "malformed: a reaction without content" '.events[] | select(.id == "m7") | .parts.body == "󰋑"'

# --- hostile profile fields stay data
new_env; install_toon; running_relay
hostile='{"name":"$(touch '"$tmp"'/pwned)","about":"`touch '"$tmp"'/pwned`; <script>","picture":"file:///etc/passwd","ilp_address":"evil","connector":"evil"}'
jq -cn --arg pk "$pk" --arg c "$hostile" '{events:[{id:"p1",pubkey:$pk,kind:0,created_at:1,tags:[],content:$c}]}' > "$STUB_DIR/profiles"
jq -cn --arg pk "$pk" --arg c '"; touch pwned #' '{events:[{id:"e1",pubkey:$pk,kind:1,created_at:2,tags:[],content:$c}]}' > "$STUB_DIR/events"
echo '{"events":[]}' > "$STUB_DIR/follows"
out=$("$root/relay-events")
count=$((count + 1))
if jq -e --arg h "$hostile" '.profiles[0].content == $h' <<<"$out" >/dev/null; then echo "ok   hostile: profile content passes through unchanged"
else echo "FAIL hostile: profile content changed"; fails=$((fails + 1)); fi
check "hostile: nothing becomes a node address" '.node.ilp_address == "" and .node.connector == ""'
echo '{"ilp_address":"g.toon.shelly","connector":"https://node.example:8080"}' > "$STUB_DIR/nip11"
out=$("$root/relay-events")
check "hostile: NIP-11, not the profile, gives the node addresses" '.node == {ilp_address: "g.toon.shelly", connector: "https://node.example:8080"}'
check "hostile: event content passes through unchanged" '.events[0].content == "\"; touch pwned #"'
[[ ! -e $tmp/pwned && ! -e pwned ]] || { echo "FAIL hostile: a command ran"; fails=$((fails + 1)); }

# --- node changes in the Activity
node_env() {
  new_env; install_toon; running_relay
  export SPACETURTLE_STATE_DIR=$tmp/state
  echo '{"events":[]}' | tee "$STUB_DIR/events" "$STUB_DIR/profiles" > "$STUB_DIR/follows"
  echo '{"relay":{"name":"Shelly","prices":{"write":"10"}}}' > "$STUB_DIR/config"
  echo '{"peers":[{"id":"alice","direction":"outbound","status":"connected"}]}' > "$STUB_DIR/peerlist"
  echo '{"channels":[{"peer":"alice","direction":"outbound","status":"open","collateral":500}]}' > "$STUB_DIR/channellist"
  echo '{"routes":[{"prefix":"g.alice","peer":"alice","price":3}]}' > "$STUB_DIR/routelist"
  echo '{"per_command":"100","per_day":"1000","remaining_today":"640"}' > "$STUB_DIR/limitshow"
}
at() { SPACETURTLE_NOW=$1 "$root/relay-events" 40 30; }
node_env
out=$(at 1000)
check "node changes: the first run, with no snapshot, has none" '.activity == [] and .urgent == false'
out=$(at 1010)
check "node changes: nothing changed, no entry" '.activity == []'
echo '{"relay":{"name":"Shelly","prices":{"write":"12"}}}' > "$STUB_DIR/config"
echo '{"peers":[{"id":"bob","direction":"inbound","status":"connected"}]}' > "$STUB_DIR/peerlist"
echo '{"channels":[{"peer":"bob","direction":"inbound","status":"open"}]}' > "$STUB_DIR/channellist"
echo '{"routes":[{"prefix":"g.bob","peer":"bob","price":1}]}' > "$STUB_DIR/routelist"
echo '{"per_command":"100","per_day":"1000","remaining_today":"600"}' > "$STUB_DIR/limitshow"
out=$(at 1020)
check "node changes: one entry per change, noticed at the time of the run" '(.activity | length) == 8 and ([.activity[] | .noticed_at == 1020 and .created_at == 1020 and .node_change == true] | all)'
check "node changes: a peering added and removed" '[.activity[].text] | (index("Peering with bob added") != null and index("Peering with alice removed") != null)'
check "node changes: a channel opened and closed" '[.activity[].text] | (index("Channel with bob opened") != null and index("Channel with alice closed") != null)'
check "node changes: a route added and removed" '[.activity[].text] | (index("Route g.bob added") != null and index("Route g.alice removed") != null)'
check "node changes: a price changed" '[.activity[].text] | index("Price write changed to 12") != null'
check "node changes: the limit drawn down" '[.activity[].text] | index("Spending limit: 600 left today, was 640") != null'
check "node changes: an entry targets the item it concerns in the Node section" '(.activity[] | select(.text == "Channel with bob opened") | .target) == {group:"Channels",label:"bob"} and (.activity[] | select(.text | startswith("Price")) | .target) == {group:"Relay",label:"Price write"}'
echo '{"routes":[{"prefix":"g.bob","peer":"carol","price":1}]}' > "$STUB_DIR/routelist"
echo '{"channels":[{"peer":"bob","direction":"inbound","status":"closing"}]}' > "$STUB_DIR/channellist"
out=$(at 1030)
check "node changes: a route and a channel changing in place" '[.activity[0:2][].text] | sort == ["Channel with bob is now closing","Route g.bob changed"]'
check "node changes: earlier entries are kept across refreshes" '(.activity | length) == 10'
out=$(at 1040)
check "node changes: still kept when nothing changed" '(.activity | length) == 10 and .activity[0].noticed_at == 1030'
rm "$STUB_DIR/channellist"
out=$(at 1050)
check "node changes: an unreadable group is not compared, so it invents nothing" '(.activity | length) == 10'
mv "$SPACETURTLE_TOON" "$tmp/toon.away"
out=$(at 1055)
check "node changes: still kept when toon is missing" '.online == false and (.activity | length) == 10'
mv "$tmp/toon.away" "$SPACETURTLE_TOON"
echo '{"channels":[{"peer":"bob","direction":"inbound","status":"closing"}]}' > "$STUB_DIR/channellist"
out=$(at 1060)
check "node changes: the group back as it was is no change" '(.activity | length) == 10'
echo '{"relay":{"name":"Shelly","prices":{"read":"2"}}}' > "$STUB_DIR/config"
echo '{"peers":[{"id":"bob","direction":"inbound","status":"disconnected"}]}' > "$STUB_DIR/peerlist"
out=$(at 1062)
check "node changes: a price set and removed, a peering changing in place" '[.activity[0:3][].text] | sort == ["Peering with bob is now disconnected","Price read set to 2","Price write removed"]'
echo '{"per_command":"100","per_day":"1000","remaining_today":"0"}' > "$STUB_DIR/limitshow"
out=$(at 1070)
check "urgent: nothing left of today's limit" '.urgent == true and .activity[0].text == "Spending limit used up for today"'
echo '{"per_command":"100","per_day":"1000","remaining_today":"5"}' > "$STUB_DIR/limitshow"
out=$(at 1080)
check "urgent: not while something is left" '.urgent == false'
echo '{"per_command":"100","per_day":"1000"}' > "$STUB_DIR/limitshow"
out=$(at 1090)
check "urgent: not when the limit is not known" '.urgent == false'

# a gap collapses the differences into one entry
node_env
at 1000 >/dev/null
echo '{"peers":[{"id":"bob","direction":"inbound","status":"connected"}]}' > "$STUB_DIR/peerlist"
echo '{"per_command":"100","per_day":"1000","remaining_today":"600"}' > "$STUB_DIR/limitshow"
out=$(at 5000)
check "node changes: after a gap, one 'since you last looked' entry" '(.activity | length) == 1 and (.activity[0].text | startswith("Since you last looked: ")) and (.activity[0].text | contains("Peering with bob added")) and (.activity[0].text | contains("600 left today")) and .activity[0].target == null and .activity[0].noticed_at == 5000'
out=$(at 5010)
check "node changes: the summary is kept too" '(.activity | length) == 1'

# bounded
node_env
at 1000 >/dev/null
for i in $(seq 1 70); do
  echo "{\"peers\":[{\"id\":\"p$i\",\"direction\":\"inbound\",\"status\":\"up\"}]}" > "$STUB_DIR/peerlist"
  out=$(at $((1000 + i)))
done
check "node changes: kept entries are bounded" '(.activity | length) == 50 and .activity[0].noticed_at == 1070'

# entries sit among the agent's own events
node_env
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
echo "{\"events\":[{\"id\":\"e1\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":1015,\"tags\":[],\"content\":\"hi\"}]}" > "$STUB_DIR/events"
at 1000 >/dev/null
echo '{"peers":[]}' > "$STUB_DIR/peerlist"
out=$(at 1020)
check "node changes: beside what the agent published, newest first, last_active its own" '[.activity[].id] == ["node-1020-0","e1"] and .last_active == 1015'
unset SPACETURTLE_STATE_DIR

echo; echo "$count checks, $fails failed"
[[ $fails -eq 0 ]]
