#!/bin/bash
# Runs relay-events, mark-seen, request and the being-observed skill's answers against a stub `toon` and `curl`,
# and the launcher's `spaceturtle start` against a stub `msb`, in a temporary home,
# and holds the agent definition to its safety rules through tests/check-agent.
# Needs only bash, jq and yq (mikefarah's). Usage: tests/run
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
fails=0 count=0
tmps=()
trap 'rm -rf "${tmps[@]}"' EXIT

new_env() {
  tmp=$(mktemp -d); tmps+=("$tmp")
  export HOME=$tmp/home SPACETURTLE_CONFIG_DIR=$tmp/config SPACETURTLE_STATE_DIR=$tmp/state
  mkdir -p "$HOME/.local/bin" "$SPACETURTLE_CONFIG_DIR" "$tmp/bin"
  export SPACETURTLE_TOON=$tmp/bin/toon
  export STUB_DIR=$tmp/stub; mkdir -p "$STUB_DIR"
  # A curl that prints the NIP-11 document in $STUB_DIR/nip11, or fails.
  cat > "$HOME/.local/bin/curl" <<'STUB'
#!/bin/bash
[[ -r $STUB_DIR/nip11 ]] && cat "$STUB_DIR/nip11"
STUB
  chmod +x "$HOME/.local/bin/curl"
}

# A toon that answers from files in $STUB_DIR; the file for `toon event query`
# depends on the filter's kinds.
install_toon() {
  cat > "$SPACETURTLE_TOON" <<'STUB'
#!/bin/bash
echo "$*" >> "$STUB_DIR/calls"
case "$1 $2" in
  "status --json") cat "$STUB_DIR/status" ;;
  "relay config") cat "$STUB_DIR/config" ;;
  "relay subscriptions")
    case "$*" in
      *--incoming*) echo '{"error":"not sold"}' ;;
      *) [[ -r $STUB_DIR/held ]] && cat "$STUB_DIR/held" || exit 1 ;;
    esac ;;
  "peer list"|"channel list"|"route list"|"limit show"|"logs --json")
    f="$STUB_DIR/$1$2"; [[ -r $f ]] && cat "$f" || exit 1 ;;
  "packet count")
    [[ -r $STUB_DIR/packetcount ]] && cat "$STUB_DIR/packetcount" || exit 2 ;;
  "packet list")
    [[ -r $STUB_DIR/packetlist ]] && cat "$STUB_DIR/packetlist" || exit 2 ;;
  "packet history")
    [[ -r $STUB_DIR/packethistory ]] && cat "$STUB_DIR/packethistory" || exit 2 ;;
  "message list")
    # A toon without the command answers 2; $STUB_DIR/messages is what a newer one prints.
    [[ -r $STUB_DIR/messages ]] && cat "$STUB_DIR/messages" || exit 2 ;;
  "event query")
    case "$*" in
      *'"ids"'*) if [[ -r $STUB_DIR/pool ]]; then jq -c --argjson f "$5" '{events: [.events[] | select(.id as $i | $f.ids | index($i))]}' "$STUB_DIR/pool"
        elif [[ -r $STUB_DIR/by-id ]]; then cat "$STUB_DIR/by-id"; else echo '{"events":[]}'; fi ;;
      *'"#e"'*) if [[ -r $STUB_DIR/replies ]]; then cat "$STUB_DIR/replies"; else echo '{"events":[]}'; fi ;;
      *'"#p"'*) if [[ -r $STUB_DIR/mentions ]]; then cat "$STUB_DIR/mentions"; else echo '{"events":[]}'; fi ;;
      *'"kinds":[3],"authors"'*) if [[ -r $STUB_DIR/own-follows ]]; then cat "$STUB_DIR/own-follows"; else echo '{"events":[]}'; fi ;;
      *'"authors"'*) if [[ -r $STUB_DIR/agent-events ]]; then cat "$STUB_DIR/agent-events"; else echo '{"events":[]}'; fi ;;
      *'"kinds":[0]'*) cat "$STUB_DIR/profiles" ;;
      *'"kinds":[3]'*) cat "$STUB_DIR/follows" ;;
      *) cat "$STUB_DIR/events" ;;
    esac ;;
  *) echo "unexpected toon $*" >&2; exit 1 ;;
esac
STUB
  chmod +x "$SPACETURTLE_TOON"
}

running_relay() {
  echo '{"agent_node":{"toon_apps":[{"apps":[{"name":"relay","running":true,"read_address":"127.0.0.1:7100"}]}]}}' > "$STUB_DIR/status"
  echo '{"relay":{"name":"Shelly"}}' > "$STUB_DIR/config"
}

check() { # name, jq expression that must be true of $out
  count=$((count + 1))
  # jq 1.6 -e succeeds on empty input, so an empty document must fail here.
  if [[ -n $out ]] && jq -e "$2" <<<"$out" >/dev/null 2>&1; then echo "ok   $1"
  else echo "FAIL $1"; echo "     expression: $2"; echo "     document:   $out"; fails=$((fails + 1)); fi
}

OFFLINE='.online == false and .attention == "urgent" and .name == "" and .self == "" and .subscribers == null and .profiles == [] and .follows == [] and .activity == [] and .last_active == null and .events == [] and .context == [] and .requests == [] and .node == {ilp_address: "", connector: ""}'
pk=$(printf 'a%.0s' {1..64}); other=$(printf 'b%.0s' {1..64})

# --- no toon
new_env
out=$(SPACETURTLE_TOON=$tmp/bin/missing "$root/relay-events")
check "no toon: the offline document" "$OFFLINE"

# --- relay not running
new_env; install_toon
echo '{"agent_node":{"toon_apps":[{"apps":[{"name":"relay","running":false}]}]}}' > "$STUB_DIR/status"
out=$("$root/relay-events")
check "relay not running: the offline document" "$OFFLINE"
! grep -q "event query" "$STUB_DIR/calls" || { echo "FAIL relay not running: queried the relay"; fails=$((fails + 1)); }

# --- a relay with events
new_env; install_toon; running_relay
echo "{\"events\":[{\"id\":\"e1\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":10,\"tags\":[],\"content\":\"hi\"},{\"id\":\"e2\",\"pubkey\":\"$other\",\"kind\":30023,\"created_at\":5,\"tags\":[],\"content\":\"long form\"}]}" > "$STUB_DIR/events"
echo "{\"events\":[{\"id\":\"p1\",\"pubkey\":\"$pk\",\"kind\":0,\"created_at\":1,\"tags\":[],\"content\":\"{\\\"name\\\":\\\"Shelly\\\"}\"}]}" > "$STUB_DIR/profiles"
echo "{\"events\":[{\"id\":\"f1\",\"pubkey\":\"$pk\",\"kind\":3,\"created_at\":2,\"tags\":[[\"p\",\"$other\"]],\"content\":\"\"}]}" > "$STUB_DIR/follows"
echo '{"name":"Shelly relay","ilp_address":"g.toon.shelly","connector":"https://node.example:8080"}' > "$STUB_DIR/nip11"
out=$("$root/relay-events" 25)
check "events: online, with the relay's name" '.online == true and .name == "Shelly"'
check "events: every event the relay returned" '[.events[].id] == ["e1","e2"]'
! grep -q '"limit":25.*"kinds"\|"kinds".*"limit":25' "$STUB_DIR/calls" || { echo "FAIL events: the feed query is limited to kinds"; fails=$((fails + 1)); }
check "events: profiles and follow lists" '(.profiles | length) == 1 and (.follows[0].tags == [["p","'"$other"'"]])'
grep -q '"limit":25' "$STUB_DIR/calls" || { echo "FAIL events: limit not passed"; fails=$((fails + 1)); }
check "events: ILP and connector come from NIP-11" '.node == {ilp_address: "g.toon.shelly", connector: "https://node.example:8080"}'
check "events: no public key file, no self" '.self == ""'
check "events: without a key the agent is unknown, and the Network holds every event" '.activity == [] and .last_active == null and ([.events[].id] == ["e1","e2"])'
check "events: subscribers null while not sold" '.subscribers == null'
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
out=$("$root/relay-events")
check "events: the public key file marks the agent" ".self == \"$pk\""
check "activity: the agent's events, apart from the Network's" '[.activity[].id] == ["e1"] and ([.events[].id] == ["e2"])'
check "activity: the time of the latest activity" '.last_active == 10'
echo "{\"events\":[{\"id\":\"f0\",\"pubkey\":\"$pk\",\"kind\":3,\"created_at\":3,\"tags\":[[\"p\",\"$other\"]],\"content\":\"\"}]}" > "$STUB_DIR/own-follows"
echo '{"events":[]}' > "$STUB_DIR/follows"
out=$("$root/relay-events"); rm "$STUB_DIR/own-follows"
check "events: the agent's own follow list, asked for by author" "[.follows[] | select(.pubkey == \"$pk\") | .id] == [\"f0\"]"
echo "{\"events\":[{\"id\":\"e0\",\"pubkey\":\"$pk\",\"kind\":7,\"created_at\":20,\"tags\":[[\"e\",\"e2\"],[\"p\",\"$other\"]],\"content\":\"+\"}]}" > "$STUB_DIR/agent-events"
out=$("$root/relay-events")
check "activity: an agent event beyond the feed's limit is found, and says what it refers to" '[.activity[].id] == ["e0","e1"] and .activity[0].refers_to == "e2" and .activity[1].refers_to == null and .last_active == 20'
check "activity: the Network excludes the agent's events" '[.events[].id] == ["e2"]'
echo "{\"events\":[{\"id\":\"e0\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":5,\"tags\":[[\"e\",\"p1\",\"\",\"reply\"],[\"e\",\"r1\",\"\",\"root\"]],\"content\":\"re\"}]}" > "$STUB_DIR/agent-events"
out=$("$root/relay-events")
check "activity: newest first, wherever each event was found" '[.activity[].id] == ["e1","e0"] and .last_active == 10'
check "activity: a reply refers to the event marked reply, not the root" '.activity[1].refers_to == "p1"'
rm "$STUB_DIR/agent-events"
echo "{\"events\":[{\"id\":\"e2\",\"pubkey\":\"$other\",\"kind\":1,\"created_at\":5,\"tags\":[],\"content\":\"x\"}]}" > "$STUB_DIR/events"
out=$("$root/relay-events")
check "activity: an agent that has done nothing" '.self != "" and .activity == [] and .last_active == null'
echo "{\"events\":[{\"id\":\"e1\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":10,\"tags\":[],\"content\":\"hi\"},{\"id\":\"e2\",\"pubkey\":\"$other\",\"kind\":30023,\"created_at\":5,\"tags\":[],\"content\":\"long form\"}]}" > "$STUB_DIR/events"
echo '{"ilp_address":5,"connector":"https://node.example:8080"}' > "$STUB_DIR/nip11"
out=$("$root/relay-events")
check "events: a non-string NIP-11 field leaves the other" '.node == {ilp_address: "", connector: "https://node.example:8080"}'
echo "not a key" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
out=$("$root/relay-events")
check "events: a malformed public key file is ignored" '.self == "" and .online == true'
rm "$STUB_DIR/nip11"
out=$("$root/relay-events")
check "events: without NIP-11 the feed still works" '.online == true and (.events | length) == 2 and .node.ilp_address == ""'
! grep -q "wallet" "$STUB_DIR/calls" || { echo "FAIL ran a wallet command"; fails=$((fails + 1)); }

# --- the Persona
new_env; install_toon; running_relay
echo '{"events":[]}' > "$STUB_DIR/events"; echo '{"events":[]}' > "$STUB_DIR/follows"
echo "{\"events\":[{\"id\":\"p0\",\"pubkey\":\"$pk\",\"kind\":0,\"created_at\":1,\"tags\":[],\"content\":\"{\\\"name\\\":\\\"Old\\\"}\"},{\"id\":\"p1\",\"pubkey\":\"$pk\",\"kind\":0,\"created_at\":5,\"tags\":[],\"content\":\"{\\\"name\\\":\\\"Shelly\\\",\\\"about\\\":\\\"A calm turtle\\\",\\\"picture\\\":\\\"https://a.example/s.png\\\"}\"},{\"id\":\"p2\",\"pubkey\":\"$other\",\"kind\":0,\"created_at\":9,\"tags\":[],\"content\":\"{\\\"name\\\":\\\"Stranger\\\"}\"}]}" > "$STUB_DIR/profiles"
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
out=$("$root/relay-events")
check "persona: the agent identity's newest profile" '.persona == {name: "Shelly", character: "A calm turtle", picture: "https://a.example/s.png", created_at: 5}'
echo '{"events":[]}' > "$STUB_DIR/profiles"
out=$("$root/relay-events")
check "persona: no profile for the agent, none" '.persona == null and .online == true'
echo "{\"events\":[{\"id\":\"p2\",\"pubkey\":\"$other\",\"kind\":0,\"created_at\":9,\"tags\":[],\"content\":\"{\\\"name\\\":\\\"Stranger\\\"}\"},{\"id\":\"p3\",\"pubkey\":\"$pk\",\"kind\":0,\"created_at\":9,\"tags\":[],\"content\":\"not json\"}]}" > "$STUB_DIR/profiles"
out=$("$root/relay-events")
check "persona: another author's profile, and one that is not JSON, are none" '.persona == null'
echo "{\"events\":[{\"id\":\"p4\",\"pubkey\":\"$pk\",\"kind\":0,\"created_at\":9,\"tags\":[],\"content\":\"{\\\"name\\\":7,\\\"about\\\":\\\"x\\\"}\"}]}" > "$STUB_DIR/profiles"
out=$("$root/relay-events")
check "persona: a profile without a name is none" '.persona == null'
echo "{\"events\":[{\"id\":\"p1\",\"pubkey\":\"$pk\",\"kind\":0,\"created_at\":5,\"tags\":[],\"content\":\"{\\\"name\\\":\\\"Shelly\\\"}\"}]}" > "$STUB_DIR/profiles"
out=$("$root/relay-events")
check "persona: a name alone, character and picture empty" '.persona == {name: "Shelly", character: "", picture: "", created_at: 5}'
rm "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
out=$("$root/relay-events")
check "persona: a missing public key file, none" '.persona == null and .self == "" and .online == true'
new_env
out=$("$root/relay-events")
check "persona: offline, none" '.persona == null and .online == false'

# --- attention
new_env; install_toon; running_relay
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
note() { echo "{\"id\":\"$1\",\"pubkey\":\"$2\",\"kind\":1,\"created_at\":$3,\"tags\":$4,\"content\":\"x\"}"; }
echo "{\"events\":[$(note s1 "$other" 50 '[]')]}" > "$STUB_DIR/events"
out=$("$root/relay-events")
check "attention: never looked, nothing to compare with" '.attention == "none" and .looked_at == null'
mkdir -p "$SPACETURTLE_STATE_DIR"; echo 100 > "$SPACETURTLE_STATE_DIR/last-looked"
out=$("$root/relay-events")
check "attention: nothing new" '.attention == "none" and .looked_at == 100'
echo "{\"events\":[$(note s1 "$other" 150 '[]')]}" > "$STUB_DIR/events"
out=$("$root/relay-events")
check "attention: a stranger's note stays none" '.attention == "none"'
echo "{\"events\":[$(note s1 "$other" 150 "[[\"p\",\"$other\"]]")]}" > "$STUB_DIR/events"
out=$("$root/relay-events")
check "attention: a note tagging someone else stays none" '.attention == "none"'
echo "{\"events\":[$(note m1 "$other" 150 "[[\"p\",\"$pk\"]]")]}" > "$STUB_DIR/events"
out=$("$root/relay-events")
check "attention: a new event tagging the agent is news" '.attention == "news"'
echo "{\"events\":[$(note m1 "$other" 90 "[[\"p\",\"$pk\"]]")]}" > "$STUB_DIR/events"
out=$("$root/relay-events")
check "attention: an event tagging the agent from before looking is none" '.attention == "none"'
echo "{\"events\":[$(note m2 "$other" 150 "[[\"p\",\"$pk\"]]")]}" > "$STUB_DIR/mentions"
out=$("$root/relay-events")
check "attention: a new event tagging the agent outside the feed's limit is news" '.attention == "news"'
rm "$STUB_DIR/mentions"
echo "{\"events\":[$(note a1 "$pk" 150 '[]')]}" > "$STUB_DIR/events"
out=$("$root/relay-events")
check "attention: a new Activity entry is news" '.attention == "news"'
"$root/mark-seen"
out=$("$root/relay-events")
check "attention: mark-seen returns news to none" '.attention == "none" and (.looked_at | . > 150)'
echo "{\"events\":[$(note a1 "$pk" 150 '[]')]}" > "$STUB_DIR/events"
echo '{"agent_node":{"toon_apps":[{"apps":[{"name":"relay","running":false}]}]}}' > "$STUB_DIR/status"
out=$("$root/relay-events")
check "attention: node down is urgent, and keeps when the Observer looked" '.attention == "urgent" and .looked_at > 150'
# relay-events keeps the node's snapshot in the same directory.
[[ $(ls "$SPACETURTLE_STATE_DIR" | grep -vx node-snapshot.json) == last-looked ]] || { echo "FAIL mark-seen: left stray files"; fails=$((fails + 1)); }

# --- the node's state
new_env; install_toon
echo '{"agent_node":{"supervisor":{"running":true,"restarts":1},"connector":{"running":false},"toon_apps":[{"apps":[{"name":"relay","running":true,"read_address":"127.0.0.1:7100","restarts":2},{"name":"chat","running":false}]}]}}' > "$STUB_DIR/status"
echo '{"relay":{"name":"Shelly","prices":{"write":"10"},"blocklist":["badkey"]}}' > "$STUB_DIR/config"
echo '{"events":[]}' | tee "$STUB_DIR/events" "$STUB_DIR/profiles" > "$STUB_DIR/follows"
echo '{"peers":[{"id":"alice","direction":"outbound","status":"connected"}]}' > "$STUB_DIR/peerlist"
echo '{"channels":[{"peer":"alice","direction":"outbound","status":"open","collateral":500}]}' > "$STUB_DIR/channellist"
echo '{"routes":[{"prefix":"g.alice","peer":"alice","price":3}]}' > "$STUB_DIR/routelist"
echo '{"per_command":"100","per_day":"1000","remaining_today":"640"}' > "$STUB_DIR/limitshow"
echo '{"subscriptions":["wss://other"]}' > "$STUB_DIR/held"
echo '{"toon_app":"relay","packets":{"fulfilled":12,"rejected":3},"rejects":{"T04":1,"F02":2},"fees_earned":"40"}' > "$STUB_DIR/packetcount"
printf '{"lines":[%s]}\n' "$(jq -cn '[range(30) | "line \(.)"] | map(tojson) | join(",")' -r)" > "$STUB_DIR/logs--json"
out=$("$root/relay-events")
check "state: supervisor, connector and each app with restarts" '.state.status == {supervisor: {running: true, restarts: 1}, connector: {running: false, restarts: 0}, apps: [{name:"relay",running:true,restarts:2},{name:"chat",running:false,restarts:0}]}'
check "state: relay name, prices and blocklist" '.state.relay == {name:"Shelly", prices:[{name:"write",price:"10"}], blocklist:["badkey"]}'
check "state: peers" '.state.peers == [{id:"alice",direction:"outbound",status:"connected"}]'
check "state: channels with collateral" '.state.channels == [{peer:"alice",direction:"outbound",status:"open",collateral:"500"}]'
check "state: routes with price" '.state.routes == [{prefix:"g.alice",peer:"alice",price:"3"}]'
check "state: spending limits and what remains" '.state.limits == {per_command:"100",per_day:"1000",remaining_today:"640"}'
check "state: subscriptions held, and incoming unavailable while not sold" '.state.subscriptions == {held:["wss://other"], incoming:null}'
check "state: the last 20 log lines" '(.state.logs | length) == 20 and .state.logs[19] == "line 29"'
check "state: packets, rejects sorted by code" '.state.packets == {fulfilled: 12, rejected: 3, rejects: [{code:"F02",count:2},{code:"T04",count:1}], fees_earned: "40"}'
grep -c "^packet count" "$STUB_DIR/calls" | grep -qx 1 || { echo "FAIL state: packet count not run exactly once"; fails=$((fails + 1)); }
grep -c "subscriptions --incoming" "$STUB_DIR/calls" | grep -qx 1 || { echo "FAIL state: asked for incoming subscriptions more than once"; fails=$((fails + 1)); }
echo '{"toon_app":"relay","packets":{"fulfilled":0,"rejected":0},"rejects":{},"fees_earned":"0"}' > "$STUB_DIR/packetcount"
out=$("$root/relay-events")
check "state: a connector that carried nothing shows zeros, not unavailable" '.state.packets == {fulfilled: 0, rejected: 0, rejects: [], fees_earned: "0"}'
echo '{"toon_app":"relay","packets":"many"}' > "$STUB_DIR/packetcount"
out=$("$root/relay-events")
check "state: packets of a shape not understood are unavailable, the rest shows" '.state.packets == null and .state.limits.per_day == "1000"'
echo '{"toon_app":"relay","packets":{"fulfilled":1,"rejected":1},"rejects":{"F02":"abc"},"fees_earned":"0"}' > "$STUB_DIR/packetcount"
out=$("$root/relay-events")
check "state: a reject count that is not a number leaves packets unavailable" '.state.packets == null'
echo '{"toon_app":"relay","packets":{"fulfilled":1,"rejected":0},"rejects":{}}' > "$STUB_DIR/packetcount"
out=$("$root/relay-events")
check "state: packets without fees earned are unavailable, not zero fees" '.state.packets == null'
echo '{"error":"not_running"}' > "$STUB_DIR/packetcount"
out=$("$root/relay-events")
check "state: packets error document is unavailable" '.state.packets == null and .state.limits.per_day == "1000"'
rm "$STUB_DIR/packetcount"
out=$("$root/relay-events")
check "state: a toon without packet count leaves packets unavailable" '.state.packets == null and .state.limits.per_day == "1000"'
echo '{"toon_app":"relay","packets":{"fulfilled":12,"rejected":3},"rejects":{"T04":1,"F02":2},"fees_earned":"40"}' > "$STUB_DIR/packetcount"
echo '{"toon_app":"relay","packets":[{"time":"2026-10-03T23:00:30.314592Z","destination":"g.a.nowhere","outcome":"rejected","code":"F02","message":"no route"},{"time":"2026-10-03T22:00:00Z","destination":"g.b","outcome":"rejected","code":"T04","message":"busy","extra":1}]}' > "$STUB_DIR/packetlist"
rm -f "$STUB_DIR/calls"
out=$("$root/relay-events")
check "state: rejected packets, in the order printed, with four fields" '.state.rejected_packets == [{time:"2026-10-03T23:00:30.314592Z",destination:"g.a.nowhere",code:"F02",message:"no route"},{time:"2026-10-03T22:00:00Z",destination:"g.b",code:"T04",message:"busy"}]'
grep -c "^packet list" "$STUB_DIR/calls" | grep -qx 1 || { echo "FAIL state: packet list not run exactly once"; fails=$((fails + 1)); }
echo '{"packets":[]}' > "$STUB_DIR/packetlist"
out=$("$root/relay-events")
check "state: no rejected packets is an empty list" '.state.rejected_packets == []'
echo '{"packets":[{"time":"t","code":"F02","message":"m","outcome":"rejected"},{"time":"t","destination":"d","code":"F02","message":"m","outcome":"fulfilled"},{"time":"t","destination":"d","code":"F02","message":"m","outcome":"rejected"}]}' > "$STUB_DIR/packetlist"
out=$("$root/relay-events")
check "state: incomplete and non-rejected entries are left out" '(.state.rejected_packets | length) == 1 and .state.rejected_packets[0].destination == "d"'
echo '{"packets":"many"}' > "$STUB_DIR/packetlist"
out=$("$root/relay-events")
check "state: rejected packets of a shape not understood are unavailable, packets still show" '.state.rejected_packets == null and .state.packets.fulfilled == 12'
echo '{"error":"not_running"}' > "$STUB_DIR/packetlist"
out=$("$root/relay-events")
check "state: rejected packets error document is unavailable" '.state.rejected_packets == null and .state.packets.fulfilled == 12'
rm "$STUB_DIR/packetlist"
out=$("$root/relay-events")
check "state: a toon without packet list leaves rejected packets unavailable" '.state.rejected_packets == null and .state.packets.fulfilled == 12'
echo '{"toon_app":"relay","dropped":3,"packets":[{"time":"2026-10-04T13:00:30.314Z","direction":"forwarded","destination":"g.toon.a.relay","from":"peer-a","to":"peer-b","amount":"1000","fee":"10","outcome":"fulfilled","extra":"x"},{"time":"2026-10-04T13:00:12.001Z","direction":"sent","destination":"g.toon.a.nowhere","amount":"0","outcome":"rejected","code":"F02","message":"no route"},{"time":"2026-10-04T13:00:00Z","outcome":"rejected","code":"R00","amount":"1000","from":"peer-a","destination":"g.d","message":"expired"},{"direction":"sent","outcome":"fulfilled"},"junk",{"time":"t","direction":"sent"},{"time":"t","outcome":"fulfilled","fee":10}]}' > "$STUB_DIR/packethistory"
: > "$STUB_DIR/calls"
out=$("$root/relay-events")
check "state: packet history, in the order printed, with only the ten fields" '.state.packet_history.packets == [{time:"2026-10-04T13:00:30.314Z",direction:"forwarded",destination:"g.toon.a.relay",from:"peer-a",to:"peer-b",amount:"1000",fee:"10",outcome:"fulfilled"},{time:"2026-10-04T13:00:12.001Z",direction:"sent",destination:"g.toon.a.nowhere",amount:"0",outcome:"rejected",code:"F02",message:"no route"},{time:"2026-10-04T13:00:00Z",outcome:"rejected",code:"R00",amount:"1000",from:"peer-a",destination:"g.d",message:"expired"},{time:"t",outcome:"fulfilled"}]'
check "state: packet history dropped count" '.state.packet_history.dropped == 3'
grep -c "^packet history --json$" "$STUB_DIR/calls" | grep -qx 1 || { echo "FAIL state: packet history not run exactly once with --json"; fails=$((fails + 1)); }
echo '{"packets":[]}' > "$STUB_DIR/packethistory"
out=$("$root/relay-events")
check "state: an empty packet history is empty, with dropped 0, not unavailable" '.state.packet_history == {packets: [], dropped: 0}'
echo '{"dropped":"3","packets":[]}' > "$STUB_DIR/packethistory"
out=$("$root/relay-events")
check "state: a packet history dropped that is not a number is 0" '.state.packet_history.dropped == 0'
echo '{"packets":[]}' > "$STUB_DIR/packetlist"
echo '{"packets":"many"}' > "$STUB_DIR/packethistory"
out=$("$root/relay-events")
check "state: packet history of a shape not understood is unavailable, the rest shows" '.state.packet_history == null and .state.packets.fulfilled == 12 and .state.rejected_packets == []'
echo '{"error":"not_running"}' > "$STUB_DIR/packethistory"
out=$("$root/relay-events")
check "state: packet history error document is unavailable" '.state.packet_history == null and .state.packets.fulfilled == 12 and .state.rejected_packets == []'
rm "$STUB_DIR/packethistory"
out=$("$root/relay-events")
check "state: a toon without packet history leaves it unavailable" '.state.packet_history == null and .state.packets.fulfilled == 12 and .state.rejected_packets == []'
rm "$STUB_DIR/packetlist"
out=$("$root/relay-events")
rm "$STUB_DIR/channellist"; echo '{"error":"no channels"}' > "$STUB_DIR/routelist"
out=$("$root/relay-events")
check "state: a failing command and an error document are unavailable, the rest shows" '.state.channels == null and .state.routes == null and (.state.peers | length) == 1 and .state.limits.per_day == "1000" and .state.status.supervisor.running == true'
echo '{"lines":"not a list"}' > "$STUB_DIR/logs--json"; echo '{"peers":["alice"]}' > "$STUB_DIR/peerlist"
out=$("$root/relay-events")
check "state: an answer of a shape not understood is unavailable, the rest shows" '.state.logs == null and .state.peers == null and .state.limits.per_day == "1000" and .state.relay.name == "Shelly"'
printf '%s\n' '"line a"' '"line b"' > "$STUB_DIR/logs--json"
out=$("$root/relay-events")
check "state: logs printed one JSON value per line" '.state.logs == ["line a","line b"]'
for bad in wallet "wallet balance" "up" "channel open" "limit set" "route add"; do
  ! grep -q "^$bad" "$STUB_DIR/calls" || { echo "FAIL state: ran toon $bad"; fails=$((fails + 1)); }
done
rm "$STUB_DIR/status"
out=$("$root/relay-events")
check "state: a failing status is unavailable, the rest shows" '.state.status == null and .state.relay.name == "Shelly" and .state.limits.per_day == "1000" and .online == false'
echo '{}' > "$STUB_DIR/status"
out=$("$root/relay-events")
check "state: no agent node, no state" '.state == null and .online == false'

# --- the parts of each kind
new_env; install_toon; running_relay
echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
ev() { jq -cn --argjson k "$1" --arg c "$2" --argjson t "$3" '{id:("k"+($k|tostring)+$c[0:3]),pubkey:"'"$pk"'",kind:$k,created_at:1,tags:$t,content:$c}'; }
{
  echo '{"events":['
  ev 0 '{"name":"Shelly","about":"turtle"}' '[]'; echo ,
  ev 1 'hello' '[]'; echo ,
  ev 1 'a reply' '[["e","'"$other"'"]]'; echo ,
  ev 3 '' '[["p","'"$other"'"],["p","'"$pk"'"]]'; echo ,
  ev 5 'mistake' '[["e","'"$other"'"]]'; echo ,
  ev 6 '' '[["e","'"$other"'"]]'; echo ,
  ev 7 '+' '[["e","'"$other"'"]]'; echo ,
  ev 16 '' '[["e","'"$other"'"]]'; echo ,
  ev 1111 'a comment' '[["e","'"$other"'"]]'; echo ,
  ev 30023 'long text' '[["title","A Title"],["summary","Sum"],["r","https://a.example/x"],["r","javascript:alert(1)"]]'; echo ,
  ev 30817 'draft text' '[["d","nip-x"],["title","Draft"]]'; echo ,
  ev 31337 'raw' '[["alt","A thing"],["x","y","z"]]'; echo ,
  ev 31338 'raw2' '[]'; echo ,
  ev 31339 'raw3' '[["k","v"],["e","'"$other"'"]]'
  echo ']}'
} > "$STUB_DIR/events"
out=$("$root/relay-events")
P() { echo ".events[] | select(.kind == $1) | .parts | $2"; }
check "parts 0: name and about" "$(P 0 '.label == "updated profile" and .title == "Shelly" and .summary == "turtle" and .body == ""')"
check "parts 1: a note" "$(P 1 'select(.ref == "") | .label == "" and .body == "hello"')"
check "parts 1: a reply refers to its event" "$(P 1 'select(.body == "a reply") | .label == "replied" and .ref == "'"$other"'"')"
check "parts 3: follows counted" "$(P 3 '.label == "updated follows" and .body == "2 followed"')"
check "parts 5: deletion refers to its target" "$(P 5 '.label == "deleted" and .ref == "'"$other"'" and .summary == "1 deleted"')"
check "parts 6: repost" "$(P 6 '.label == "reposted" and .ref == "'"$other"'" and .body == ""')"
check "parts 7: reaction" "$(P 7 '.label == "reacted" and .body == "󰋑"')"
check "parts 16: generic repost" "$(P 16 '.label == "reposted" and .ref == "'"$other"'"')"
check "parts 1111: comment" "$(P 1111 '.label == "commented" and .body == "a comment"')"
check "parts 30023: article, only http(s) links" "$(P 30023 '.label == "published" and .title == "A Title" and .summary == "Sum" and .links == ["https://a.example/x"]')"
check "parts 30817: NIP draft" "$(P 30817 '.label == "drafted" and .title == "Draft" and .body == "draft text"')"
check "parts unknown with alt: alt, kind, tags, content" "$(P 31337 '.label == "kind 31337" and .title == "A thing" and .summary == "alt A thing, x y z" and .body == "raw"')"
check "parts unknown without alt: kind, content" "$(P 31338 '.label == "kind 31338" and .title == "" and .summary == "" and .body == "raw2"')"
check "parts unknown without alt, with tags: kind, tags, content" "$(P 31339 '.label == "kind 31339" and .title == "" and .summary == "k v, e '"$other"'" and .body == "raw3"')"
check "parts: every event has all the parts" '[.events[].parts | keys == ["body","label","links","media","ref","summary","title"]] | all'

# --- media: what an event shows or plays
new_env; install_toon; running_relay
echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
{
  echo '{"events":['
  ev 1 'in text https://a.example/one.PNG and https://a.example/page then https://a.example/two.gif?w=2 https://a.example/clip.mp4 https://a.example/song.ogg' '[]'; echo ,
  ev 20 'tagged' '[["imeta","url https://a.example/blob","m image/png"],["imeta","url https://a.example/clip","m video/mp4"],["imeta","url https://a.example/three.webp"],["imeta","url file:///etc/passwd","m image/png"],["imeta","url https://a.example/blob","m image/png"],["imeta","url https://a.example/doc.png","m application/pdf"]]'; echo ,
  ev 5094 '' '[["i","aGVsbG8=","blob"],["bid","1000","usdc"],["output","image/png"]]'; echo ,
  ev 5094 'x' '[["i","file:///etc/passwd","blob"],["output","image/png"]]'; echo ,
  ev 5094 'y' '[["i","aGVsbG8=","blob"],["output","text/html"]]'; echo ,
  ev 21 'https://a.example/1.png https://a.example/2.png https://a.example/3.png https://a.example/4.png https://a.example/5.png file:///x.png' '[["imeta",{"a":1}]]'
  echo ']}'
} > "$STUB_DIR/events"
out=$("$root/relay-events")
check "media: the addresses in the text that end as a picture, a video or a sound" "$(P 1 '.media == [
  {url:"https://a.example/one.PNG",type:"image",moving:false},{url:"https://a.example/two.gif?w=2",type:"image",moving:true},
  {url:"https://a.example/clip.mp4",type:"video",moving:false},{url:"https://a.example/song.ogg",type:"audio",moving:false}]')"
check "media: what an imeta tag says it is, http(s) only, once" "$(P 20 '[.media[] | .url + " " + .type] == ["https://a.example/blob image","https://a.example/clip video","https://a.example/three.webp image"]')"
check "media: at most four, a malformed imeta tag costs nothing" "$(P 21 '[.media[].url] == ["https://a.example/1.png","https://a.example/2.png","https://a.example/3.png","https://a.example/4.png"]')"
check "media: a stored picture is shown from its own bytes" '.events[] | select(.id == "k5094") | .parts | . == {label:"stored a file", title:"", summary:"image/png, 5 bytes", body:"", links:[], media:[{url:"data:image/png;base64,aGVsbG8=",type:"image",moving:false}], ref:""}'
check "media: a stored file that is not base64, or not a picture, shows none" '[.events[] | select(.id == "k5094x" or .id == "k5094y") | .parts.media] == [[],[]]'

# --- malformed tags and content cost only the odd part, never the feed
new_env; install_toon; running_relay
echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
echo '{"events":[
  {"id":"m3","kind":3,"tags":["p",{"a":1}],"content":""},
  {"id":"m5","kind":5,"tags":[{"a":1},"e"],"content":""},
  {"id":"m1","kind":1,"tags":"oops","content":"still here"},
  {"id":"m7","kind":7,"tags":[],"content":null}
]}' > "$STUB_DIR/events"
out=$("$root/relay-events")
check "malformed: every event survives" '[.events[].id] == ["m3","m5","m1","m7"]'
check "malformed: no tags counted" '[.events[] | select(.id == "m3" or .id == "m5") | .parts | .body, .summary] == ["0 followed","","","0 deleted"]'
check "malformed: a note with string tags" '.events[] | select(.id == "m1") | .parts | .body == "still here" and .ref == "" and .links == [] and .media == []'
check "malformed: a reaction without content" '.events[] | select(.id == "m7") | .parts.body == "󰋑"'

# --- hostile profile fields stay data
new_env; install_toon; running_relay
hostile='{"name":"$(touch '"$tmp"'/pwned)","about":"`touch '"$tmp"'/pwned`; <script>","picture":"file:///etc/passwd","ilp_address":"evil","connector":"evil"}'
jq -cn --arg pk "$pk" --arg c "$hostile" '{events:[{id:"p1",pubkey:$pk,kind:0,created_at:1,tags:[],content:$c}]}' > "$STUB_DIR/profiles"
jq -cn --arg pk "$pk" --arg c '"; touch pwned #' '{events:[{id:"e1",pubkey:$pk,kind:1,created_at:2,tags:[],content:$c}]}' > "$STUB_DIR/events"
echo '{"events":[]}' > "$STUB_DIR/follows"
out=$("$root/relay-events")
count=$((count + 1))
if jq -e --arg h "$hostile" '.profiles[0].content == $h' <<<"$out" >/dev/null; then echo "ok   hostile: profile content passes through unchanged"
else echo "FAIL hostile: profile content changed"; fails=$((fails + 1)); fi
check "hostile: nothing becomes a node address" '.node.ilp_address == "" and .node.connector == ""'
echo '{"ilp_address":"g.toon.shelly","connector":"https://node.example:8080"}' > "$STUB_DIR/nip11"
out=$("$root/relay-events")
check "hostile: NIP-11, not the profile, gives the node addresses" '.node == {ilp_address: "g.toon.shelly", connector: "https://node.example:8080"}'
check "hostile: event content passes through unchanged" '.events[0].content == "\"; touch pwned #"'
[[ ! -e $tmp/pwned && ! -e pwned ]] || { echo "FAIL hostile: a command ran"; fails=$((fails + 1)); }

# --- Renderers the agent writes: one JSON file per kind in the configuration directory
new_env; install_toon; running_relay
echo '{"events":[]}' | tee "$STUB_DIR/profiles" > "$STUB_DIR/follows"
mkdir -p "$SPACETURTLE_CONFIG_DIR/renderers"; rd=$SPACETURTLE_CONFIG_DIR/renderers
cat > "$rd/draft.json" <<JSON
{"kind":31990,"label":"NIP draft","title":{"tag":"title"},"summary":{"tag":"summary"},"body":{"content":true},
 "links":[{"tag":"r"}],"refers_to":{"tag":"e"},"added_later":"ignored"}
JSON
echo '{"kind":31991,"title":{"tag":"title"}' > "$rd/broken.json"                       # not JSON
echo '{"kind":"31992","title":{"tag":"title"}}' > "$rd/badkind.json"                    # kind is not a number
echo '{"kind":31993,"title":{"tag":["title"]}}' > "$rd/badsource.json"                  # a source that names no tag
echo '{"kind":31994,"title":{"eval":"touch pwned"}}' > "$rd/evil.json"                  # nothing is evaluated
echo '{"kind":1,"label":"hijacked","body":{"tag":"title"}}' > "$rd/note.json"           # a built-in kind
echo '{"kind":30023,"label":"hijacked","title":{"content":true}}' > "$rd/article.json" # a built-in kind
echo '{"kind":31995,"label":"Sparse","title":{"tag":"title"},"refers_to":{"tag":"e"},"links":[{"tag":"r"}]}' > "$rd/sparse.json"
echo '{"kind":31996,"label":"Partial","title":{"tag":"title"},"summary":{"tag":"summary"}}' > "$rd/partial.json"
echo '{"kind":31997,"title":{"tag":5,"content":true}}' > "$rd/twoshapes.json"         # a source of both shapes
echo '{"kind":31998,"label":"one"}{"kind":31999,"label":"two"}' > "$rd/several.json"    # more than one description
echo '{"kind":31990,"label":"second"}' > "$rd/zz-duplicate.json"                       # the first by file name wins
{
  echo '{"events":['
  ev 31990 'the draft' '[["title","My NIP"],["summary","Sum"],["r","https://a.example/x"],["r","javascript:alert(1)"],["e","'"$other"'"]]'; echo ,
  ev 31991 'c1' '[["title","T1"]]'; echo ,
  ev 31992 'c2' '[["title","T2"]]'; echo ,
  ev 31993 'c3' '[["title","T3"]]'; echo ,
  ev 31994 'c4' '[["title","T4"]]'; echo ,
  ev 1 'plain note' '[["title","not used"]]'; echo ,
  ev 30023 'article' '[["title","Real title"]]'; echo ,
  ev 31995 'c5' '[["x","y"]]'; echo ,
  ev 31996 'c6' '[["title","T6"]]'; echo ,
  ev 31997 'c7' '[["title","T7"]]'; echo ,
  ev 31998 'c8' '[]'; echo ,
  ev 31999 'c9' '[]'
  echo ']}'
} > "$STUB_DIR/events"
out=$("$root/relay-events")
P() { echo ".events[] | select(.kind == $1) | .parts | $2"; }
check "renderer: a valid description resolves label, title, summary, body, links and the event referred to" "$(P 31990 '. == {label:"NIP draft", title:"My NIP", summary:"Sum", body:"the draft", links:["https://a.example/x"], media:[], ref:"'"$other"'"}')"
for k in 31991 31992 31993 31994 31997 31998 31999; do
  check "renderer: an unusable description for $k falls back" "$(P $k '.label == "kind '$k'" and .body == "c'$((k - 31990))'"')"
done
check "renderer: a description for a built-in kind is ignored" "$(P 1 '.label == "" and .body == "plain note"')"
check "renderer: a description for a built-in long-form post is ignored" "$(P 30023 '.label == "published" and .title == "Real title"')"
check "renderer: an event lacking every tag its description names falls back" "$(P 31995 '. == {label:"kind 31995", title:"", summary:"x y", body:"c5", links:[], media:[], ref:""}')"
check "renderer: a tag the event lacks leaves that part empty, the rest stays" "$(P 31996 '. == {label:"Partial", title:"T6", summary:"", body:"", links:[], media:[], ref:""}')"
check "renderer: the document is whole" '.online == true and (.events | length) == 12'
[[ ! -e pwned && ! -e $tmp/pwned ]] || { echo "FAIL renderer: a description was evaluated"; fails=$((fails + 1)); }
# A new description takes effect on the next run, with nothing restarted; removing it takes it away.
echo '{"kind":31991,"label":"Fixed","title":{"tag":"title"}}' > "$rd/broken.json"
out=$("$root/relay-events")
check "renderer: a description added or mended shows on the next run" "$(P 31991 '.label == "Fixed" and .title == "T1"')"
rm "$rd/broken.json"
out=$("$root/relay-events")
check "renderer: a removed description falls back" "$(P 31991 '.label == "kind 31991"')"
rm -r "$rd"
out=$("$root/relay-events")
check "renderer: no directory, the fallback" "$(P 31990 '.label == "kind 31990" and .body == "the draft"')"

# --- node changes in the Activity
node_env() {
  new_env; install_toon; running_relay
  export SPACETURTLE_STATE_DIR=$tmp/state
  echo '{"events":[]}' | tee "$STUB_DIR/events" "$STUB_DIR/profiles" > "$STUB_DIR/follows"
  echo '{"relay":{"name":"Shelly","prices":{"write":"10"}}}' > "$STUB_DIR/config"
  echo '{"peers":[{"id":"alice","direction":"outbound","status":"connected"}]}' > "$STUB_DIR/peerlist"
  echo '{"channels":[{"peer":"alice","direction":"outbound","status":"open","collateral":500}]}' > "$STUB_DIR/channellist"
  echo '{"routes":[{"prefix":"g.alice","peer":"alice","price":3}]}' > "$STUB_DIR/routelist"
  echo '{"per_command":"100","per_day":"1000","remaining_today":"640"}' > "$STUB_DIR/limitshow"
  echo '{"packets":{"fulfilled":12,"rejected":3},"rejects":{"F02":2,"T04":1},"fees_earned":"40"}' > "$STUB_DIR/packetcount"
}
at() { SPACETURTLE_NOW=$1 "$root/relay-events" 40 30; }
node_env
out=$(at 1000)
check "node changes: the first run, with no snapshot, has none" '.activity == [] and .urgent == false'
out=$(at 1010)
check "node changes: nothing changed, no entry" '.activity == []'
echo '{"packets":{"fulfilled":0,"rejected":0},"rejects":{},"fees_earned":"0"}' > "$STUB_DIR/packetcount"
out=$(at 1012)
check "node changes: packet counts falling to 0 add nothing and leave attention alone" '.activity == [] and .urgent == false and .attention == "none"'
echo '{"packets":{"fulfilled":99,"rejected":9},"rejects":{"F02":9},"fees_earned":"7"}' > "$STUB_DIR/packetcount"
out=$(at 1014)
check "node changes: packet counts moving add nothing" '.activity == [] and .urgent == false and .attention == "none"'
echo '{"packets":[{"time":"t","destination":"d","outcome":"rejected","code":"F02","message":"m"}]}' > "$STUB_DIR/packetlist"
out=$(at 1015)
check "node changes: new rejected packets add nothing and leave attention alone" '.activity == [] and .urgent == false and .attention == "none"'
echo '{"dropped":2,"packets":[{"time":"t","direction":"sent","outcome":"rejected","code":"F02","message":"m"}]}' > "$STUB_DIR/packethistory"
out=$(at 1016)
check "node changes: new packet history rows add nothing and leave attention alone" '.activity == [] and .urgent == false and .attention == "none"'
echo '{"packets":[]}' > "$STUB_DIR/packethistory"
out=$(at 1017)
check "node changes: vanished packet history rows add nothing" '.activity == [] and .urgent == false and .attention == "none"'
rm "$STUB_DIR/packethistory"
echo '{"relay":{"name":"Shelly","prices":{"write":"12"}}}' > "$STUB_DIR/config"
echo '{"peers":[{"id":"bob","direction":"inbound","status":"connected"}]}' > "$STUB_DIR/peerlist"
echo '{"channels":[{"peer":"bob","direction":"inbound","status":"open"}]}' > "$STUB_DIR/channellist"
echo '{"routes":[{"prefix":"g.bob","peer":"bob","price":1}]}' > "$STUB_DIR/routelist"
echo '{"per_command":"100","per_day":"1000","remaining_today":"600"}' > "$STUB_DIR/limitshow"
out=$(at 1020)
check "node changes: one entry per change, noticed at the time of the run" '(.activity | length) == 8 and ([.activity[] | .noticed_at == 1020 and .created_at == 1020 and .node_change == true] | all)'
check "node changes: a peering added and removed" '[.activity[].text] | (index("Peering with bob added") != null and index("Peering with alice removed") != null)'
check "node changes: a channel opened and closed" '[.activity[].text] | (index("Channel with bob opened") != null and index("Channel with alice closed") != null)'
check "node changes: a route added and removed" '[.activity[].text] | (index("Route g.bob added") != null and index("Route g.alice removed") != null)'
check "node changes: a price changed" '[.activity[].text] | index("Price write changed to 12") != null'
check "node changes: the limit drawn down" '[.activity[].text] | index("Spending limit: 600 left today, was 640") != null'
check "node changes: an entry targets the item it concerns in the Node section" '(.activity[] | select(.text == "Channel with bob opened") | .target) == {group:"Channels",label:"bob"} and (.activity[] | select(.text | startswith("Price")) | .target) == {group:"Relay",label:"Price write"}'
echo '{"routes":[{"prefix":"g.bob","peer":"carol","price":1}]}' > "$STUB_DIR/routelist"
echo '{"channels":[{"peer":"bob","direction":"inbound","status":"closing"}]}' > "$STUB_DIR/channellist"
out=$(at 1030)
check "node changes: a route and a channel changing in place" '[.activity[0:2][].text] | sort == ["Channel with bob is now closing","Route g.bob changed"]'
check "node changes: earlier entries are kept across refreshes" '(.activity | length) == 10'
out=$(at 1040)
check "node changes: still kept when nothing changed" '(.activity | length) == 10 and .activity[0].noticed_at == 1030'
rm "$STUB_DIR/channellist"
out=$(at 1050)
check "node changes: an unreadable group is not compared, so it invents nothing" '(.activity | length) == 10'
mv "$SPACETURTLE_TOON" "$tmp/toon.away"
out=$(at 1055)
check "node changes: still kept when toon is missing" '.online == false and (.activity | length) == 10'
mv "$tmp/toon.away" "$SPACETURTLE_TOON"
echo '{"channels":[{"peer":"bob","direction":"inbound","status":"closing"}]}' > "$STUB_DIR/channellist"
out=$(at 1060)
check "node changes: the group back as it was is no change" '(.activity | length) == 10'
echo '{"relay":{"name":"Shelly","prices":{"read":"2"}}}' > "$STUB_DIR/config"
echo '{"peers":[{"id":"bob","direction":"inbound","status":"disconnected"}]}' > "$STUB_DIR/peerlist"
out=$(at 1062)
check "node changes: a price set and removed, a peering changing in place" '[.activity[0:3][].text] | sort == ["Peering with bob is now disconnected","Price read set to 2","Price write removed"]'
echo '{"per_command":"100","per_day":"1000","remaining_today":"0"}' > "$STUB_DIR/limitshow"
out=$(at 1070)
check "urgent: nothing left of today's limit" '.urgent == true and .attention == "urgent" and .activity[0].text == "Spending limit used up for today"'
echo '{"per_command":"100","per_day":"1000","remaining_today":"5"}' > "$STUB_DIR/limitshow"
out=$(at 1080)
check "urgent: not while something is left" '.urgent == false and .attention != "urgent"'
echo '{"per_command":"100","per_day":"1000"}' > "$STUB_DIR/limitshow"
out=$(at 1090)
check "urgent: not when the limit is not known" '.urgent == false'

# a gap collapses the differences into one entry
node_env
at 1000 >/dev/null
echo '{"peers":[{"id":"bob","direction":"inbound","status":"connected"}]}' > "$STUB_DIR/peerlist"
echo '{"per_command":"100","per_day":"1000","remaining_today":"600"}' > "$STUB_DIR/limitshow"
out=$(at 5000)
check "node changes: after a gap, one 'since you last looked' entry" '(.activity | length) == 1 and (.activity[0].text | startswith("Since you last looked: ")) and (.activity[0].text | contains("Peering with bob added")) and (.activity[0].text | contains("600 left today")) and .activity[0].target == null and .activity[0].noticed_at == 5000'
out=$(at 5010)
check "node changes: the summary is kept too" '(.activity | length) == 1'

# bounded
node_env
at 1000 >/dev/null
for i in $(seq 1 70); do
  echo "{\"peers\":[{\"id\":\"p$i\",\"direction\":\"inbound\",\"status\":\"up\"}]}" > "$STUB_DIR/peerlist"
  out=$(at $((1000 + i)))
done
check "node changes: kept entries are bounded" '(.activity | length) == 50 and .activity[0].noticed_at == 1070'

# entries sit among the agent's own events
node_env
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
echo "{\"events\":[{\"id\":\"e1\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":1015,\"tags\":[],\"content\":\"hi\"}]}" > "$STUB_DIR/events"
at 1000 >/dev/null
echo '{"peers":[]}' > "$STUB_DIR/peerlist"
out=$(at 1020)
check "node changes: beside what the agent published, newest first, last_active its own" '[.activity[].id] == ["node-1020-0","e1"] and .last_active == 1015'
unset SPACETURTLE_STATE_DIR

# --- threads: what each event refers to, and what refers to it
new_env; install_toon; running_relay
echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
t() { jq -cn --arg id "$1" --arg pk "$2" --argjson at "$3" --argjson tags "$4" --argjson kind "${5:-1}" '{id:$id,pubkey:$pk,kind:$kind,created_at:$at,tags:$tags,content:("c"+$id)}'; }
# feed: a reply to a root the limit left out, and a reply to an event nobody holds
echo "{\"events\":[$(t r1 "$other" 20 '[["e","root","","reply"]]'),$(t lost "$other" 15 '[["e","gone"]]')]}" > "$STUB_DIR/events"
echo "{\"events\":[$(t root "$other" 10 '[]')]}" > "$STUB_DIR/by-id"
echo "{\"events\":[$(t r2 "$pk" 30 '[["e","r1","","reply"],["e","root","","root"]]'),$(t like "$other" 25 '[["e","r1"]]' 7)]}" > "$STUB_DIR/replies"
echo "{\"events\":[$(t r2 "$pk" 30 '[["e","r1","","reply"],["e","root","","root"]]')]}" > "$STUB_DIR/agent-events"
out=$("$root/relay-events")
check "threads: an event outside the limit is fetched by id, as context" '[.context[].id] | index("root") != null'
check "threads: replies to shown events are fetched, as context" '[.context[].id] | index("like") != null'
check "threads: a reply refers to the event marked reply, and is not missing when the relay holds it" '.events[] | select(.id == "r1") | .refers_to == "root" and .refers_missing == false'
check "threads: what refers to an event, oldest first" '(.context[] | select(.id == "root") | .referenced_by) == ["r1"] and (.events[] | select(.id == "r1") | .referenced_by) == ["like","r2"]'
check "threads: a reply to a missing event is marked missing" '.events[] | select(.id == "lost") | .refers_to == "gone" and .refers_missing == true and .referenced_by == []'
check "threads: the agent's reply is activity, apart from context" '[.activity[].id] == ["r2"] and ([.context[].id] | index("r2") == null)'
check "threads: a note refers to nothing" '.context[] | select(.id == "root") | .refers_to == null and .refers_missing == false'
rm "$STUB_DIR/by-id"
out=$("$root/relay-events")
check "threads: a root the relay does not return is missing" '.events[] | select(.id == "r1") | .refers_missing == true'

# a chain deeper than the walk: what is past it is not asked for, so not missing
rm -f "$STUB_DIR/replies" "$STUB_DIR/agent-events"
echo "{\"events\":[$(t d4 "$other" 40 '[["e","d3"]]')]}" > "$STUB_DIR/events"
echo "{\"events\":[$(t d3 "$other" 30 '[["e","d2"]]'),$(t d2 "$other" 20 '[["e","d1"]]'),$(t d1 "$other" 10 '[["e","d0"]]'),$(t d0 "$other" 5 '[]')]}" > "$STUB_DIR/pool"
out=$("$root/relay-events")
check "threads: a chain is fetched up to the walk's depth" '[.context[].id] | sort == ["d1","d2","d3"]'
check "threads: a reference past the walk is not marked missing" '.context[] | select(.id == "d1") | .refers_to == "d0" and .refers_missing == false'

# --- requests: the request script
bad() { # name, command...: must exit non-zero
  local name=$1; shift; count=$((count + 1))
  if "$@" >/dev/null 2>&1; then echo "FAIL $name"; fails=$((fails + 1)); else echo "ok   $name"; fi
}
new_env
queue=$SPACETURTLE_STATE_DIR/requests
id=$("$root/request" add "Please follow someone interesting")
out=$(jq -c . "$queue/$id.json")
check "request: written as a waiting free Request" ".id == \"$id\" and .kind == \"free\" and .state == \"waiting\" and .text == \"Please follow someone interesting\" and (.created_at | type) == \"number\" and .answered_at == null and .result == null and .reason == null"
[[ $(ls "$queue" | wc -l) -eq 1 ]] || { echo "FAIL request: leftover files in the queue"; fails=$((fails + 1)); }
"$root/request" withdraw "$id"
count=$((count + 1))
if [[ ! -e $queue/$id.json ]]; then echo "ok   request: a waiting Request is withdrawn"; else echo "FAIL request: not withdrawn"; fails=$((fails + 1)); fi
bad "request: withdrawing it again is refused" "$root/request" withdraw "$id"
for state in done declined; do
  id=$("$root/request" add "answered $state")
  jq --arg s "$state" '.state = $s | .answered_at = 99' "$queue/$id.json" > "$tmp/x" && mv "$tmp/x" "$queue/$id.json"
  bad "request: a $state Request is not withdrawn" "$root/request" withdraw "$id"
  count=$((count + 1))
  if [[ -e $queue/$id.json ]]; then echo "ok   request: the $state Request is still there"; else echo "FAIL request: the $state Request was removed"; fails=$((fails + 1)); fi
done
bad "request: an id with a path is refused" "$root/request" withdraw "../../x"
bad "request: no text for a free Request is refused" "$root/request" add "  "
bad "request: an unknown kind is refused" "$root/request" add --kind nonsense "x"
nasty=$'He said "hi" \\ \'quoted\'\nsecond line $(touch '"$tmp"'/pwned) `touch '"$tmp"'/pwned`; touch pwned #\ttab *'
id=$("$root/request" add "$nasty")
count=$((count + 1))
if jq -e --arg t "$nasty" '.text == $t' "$queue/$id.json" >/dev/null; then echo "ok   request: quotes, newlines and shell characters are kept as text"
else echo "FAIL request: text changed"; fails=$((fails + 1)); fi
[[ ! -e $tmp/pwned && ! -e pwned ]] || { echo "FAIL request: a command ran"; fails=$((fails + 1)); }
id=$("$root/request" add --kind follow --pubkey "$pk" "and say hello")
out=$(jq -c . "$queue/$id.json")
check "request: a kind and a subject" ".kind == \"follow\" and .subject == {pubkey: \"$pk\", event: null}"
for k in follow unfollow; do
  id=$("$root/request" add --kind $k --pubkey "$pk" "")
  out=$(jq -c . "$queue/$id.json")
  check "request: $k names its author, the text is optional" ".kind == \"$k\" and .subject == {pubkey: \"$pk\", event: null} and .text == \"\" and .state == \"waiting\""
  bad "request: $k with no subject is refused" "$root/request" add --kind $k "text"
  bad "request: $k with only a note is refused" "$root/request" add --kind $k --event "$pk"
done
note_id=$(printf 'b%.0s' {1..64})
for k in reply react repost; do
  id=$("$root/request" add --kind $k --event "$note_id" --pubkey "$pk" "my words")
  out=$(jq -c . "$queue/$id.json")
  check "request: $k names its note and author" ".kind == \"$k\" and .subject == {pubkey: \"$pk\", event: \"$note_id\"} and .text == \"my words\""
  id=$("$root/request" add --kind $k --event "$pk" "")
  out=$(jq -c . "$queue/$id.json")
  check "request: $k without text is written" ".kind == \"$k\" and .subject.event == \"$pk\" and .text == \"\""
  bad "request: $k with no subject is refused" "$root/request" add --kind $k "text"
  bad "request: $k with only an author is refused" "$root/request" add --kind $k --pubkey "$pk" "text"
done

# --- requests in the observation document
new_env; install_toon; running_relay
queue=$SPACETURTLE_STATE_DIR/requests; mkdir -p "$queue"
echo '{"events":[]}' > "$STUB_DIR/events"; echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
ev=$(printf 'c%.0s' {1..64})
out=$("$root/relay-events")
check "requests: none in the queue" '.requests == [] and .activity == []'
echo "{\"id\":\"w\",\"created_at\":100,\"kind\":\"free\",\"subject\":{},\"text\":\"waiting one\",\"state\":\"waiting\",\"answered_at\":null,\"result\":null,\"reason\":null}" > "$queue/1-aa.json"
echo "{\"id\":\"d\",\"created_at\":110,\"kind\":\"free\",\"subject\":{},\"text\":\"done one\",\"state\":\"done\",\"answered_at\":150,\"result\":{\"event\":\"$ev\"},\"reason\":null}" > "$queue/2-bb.json"
echo "{\"id\":\"x\",\"created_at\":120,\"kind\":\"free\",\"subject\":{},\"text\":\"declined one\",\"state\":\"declined\",\"answered_at\":140,\"result\":null,\"reason\":\"Not in character\"}" > "$queue/3-cc.json"
out=$("$root/relay-events")
check "requests: listed newest first with their states" '[.requests[] | [.id, .state]] == [["3-cc","declined"],["2-bb","done"],["1-aa","waiting"]]'
check "requests: the answer and the reason" '.requests[1].result.event == "'"$ev"'" and .requests[0].reason == "Not in character"'
check "requests: answered ones are Activity entries, newest first; a waiting one is not" '[.activity[].id] == ["request:2-bb","request:3-cc"]'
check "requests: a done entry refers to what the agent published" '.activity[0].refers_to == "'"$ev"'" and .activity[0].request.state == "done" and .activity[0].created_at == 150'
check "requests: a declined entry carries the reason" '.activity[1].refers_to == null and .activity[1].request.reason == "Not in character"'
check "requests: an outcome is the agent's last activity" '.last_active == 150'
echo '{"events":[{"id":"e1","pubkey":"'"$pk"'","kind":1,"created_at":200,"tags":[],"content":"hi"}]}' > "$STUB_DIR/events"
out=$("$root/relay-events")
check "requests: outcomes and events share the Activity" '[.activity[].id] == ["e1","request:2-bb","request:3-cc"] and .last_active == 200'
echo '{ not json' > "$queue/4-dd.json"
echo '[1,2]' > "$queue/5-ee.json"
echo '{"id":"m","created_at":"soon","kind":"free","text":"t","state":"waiting"}' > "$queue/6-ff.json"
echo '{"id":"m","created_at":1,"kind":"free","text":"t","state":"whatever"}' > "$queue/7-gg.json"
: > "$queue/8-hh.json"
echo '{"bad' > "$queue/9-ii.json" # last in the queue, so it is the last file read
out=$("$root/relay-events")
check "requests: malformed files are skipped and the document is whole" '.online == true and [.requests[].id] == ["3-cc","2-bb","1-aa"] and (.activity | length) == 3'
echo '{"agent_node":{"toon_apps":[{"apps":[{"name":"relay","running":false}]}]}}' > "$STUB_DIR/status"
out=$("$root/relay-events")
check "requests: still listed while the relay is not running" '.online == false and (.requests | length) == 3'
check "requests: without the relay, the answers are the Activity and the last activity" '[.activity[].id] == ["request:2-bb","request:3-cc"] and .last_active == 150'

# --- the being-observed skill: a Request answered the way it says appears as done or declined
skill=$root/skills/being-observed/SKILL.md
block() { awk -v tag="$1" '$0 ~ "^```sh " tag "$" {on=1; next} on && /^```$/ {exit} on' "$skill"; }
new_env; install_toon; running_relay
queue=$SPACETURTLE_STATE_DIR/requests; mkdir -p "$queue"
echo '{"events":[]}' > "$STUB_DIR/events"; echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
ev=$(printf 'd%.0s' {1..64})
a=$("$root/request" add "answer me"); b=$("$root/request" add --kind follow --pubkey "$pk" "answer me too")
cp "$queue/$a.json" "$tmp/a.before"; cp "$queue/$b.json" "$tmp/b.before"
[[ -n $(block answer-done) && -n $(block answer-declined) ]] || { echo "FAIL skill: the answer commands are missing"; fails=$((fails + 1)); }
FILE=$queue/$a.json EVENT=$ev NOW=500 bash -c "$(block answer-done)"
FILE=$queue/$b.json REASON="Not in character" NOW=600 bash -c "$(block answer-declined)"
out=$("$root/relay-events")
check "skill: a done answer shows as done with its event" ".requests[] | select(.id == \"$a\") | .state == \"done\" and .result.event == \"$ev\" and .answered_at == 500"
check "skill: a declined answer shows as declined with its reason" ".requests[] | select(.id == \"$b\") | .state == \"declined\" and .reason == \"Not in character\" and .answered_at == 600"
check "skill: both answers are Activity entries" "[.activity[].id] == [\"request:$b\", \"request:$a\"] and .activity[1].refers_to == \"$ev\""
# Nothing but state, answered_at, result and reason changed.
count=$((count + 1))
unanswered() { jq -S 'del(.state, .answered_at, .result, .reason)' "$1"; }
if [[ $(unanswered "$queue/$a.json") == $(unanswered "$tmp/a.before") \
   && $(unanswered "$queue/$b.json") == $(unanswered "$tmp/b.before") \
   && $(ls -A "$queue" | wc -l) -eq 2 ]]; then echo "ok   skill: only state, answered_at, result and reason changed, and no file was left or added"
else echo "FAIL skill: an answer changed more than it may"; fails=$((fails + 1)); fi
# An answered Request is left alone, and a withdrawn one is not brought back.
c=$("$root/request" add "withdraw me"); "$root/request" withdraw "$c" >/dev/null
FILE=$queue/$a.json REASON="Changed my mind" NOW=700 bash -c "$(block answer-declined)" 2>/dev/null
FILE=$queue/$c.json EVENT=$ev NOW=700 bash -c "$(block answer-done)" 2>/dev/null
out=$("$root/relay-events")
check "skill: an answer leaves a done Request and a withdrawn one alone" ".requests[] | select(.id == \"$a\") | .state == \"done\" and .answered_at == 500"
count=$((count + 1))
if [[ ! -e $queue/$c.json && $(ls -A "$queue" | wc -l) -eq 2 ]]; then echo "ok   skill: a withdrawn Request stays withdrawn"
else echo "FAIL skill: a withdrawn Request came back"; fails=$((fails + 1)); fi

# --- private messages
new_env; install_toon; running_relay
echo '{"events":[]}' > "$STUB_DIR/events"; echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
third=$(printf 'c%.0s' {1..64})
out=$("$root/relay-events")
check "messages: a toon without the command leaves them locked, and the rest whole" '.messages == {readable: false, reason: "unsupported", supervisor: false, conversations: []} and .online == true'
echo '{"error":{"code":"agent_key_not_kept","message":"not kept"}}' > "$STUB_DIR/messages"
out=$("$root/relay-events")
check "messages: without the kept secret they are locked, with the reason" '.messages.readable == false and .messages.reason == "agent_key_not_kept"'
echo '{"error":{"code":"io","message":"x"}}' > "$STUB_DIR/messages"
out=$("$root/relay-events")
check "messages: another error is unavailable" '.messages.readable == false and .messages.reason == "unavailable"'
echo 'not json' > "$STUB_DIR/messages"
out=$("$root/relay-events")
check "messages: an answer that is not JSON is unavailable" '.messages.reason == "unavailable" and .online == true'
echo '{"messages":[],"supervisor":"running"}' > "$STUB_DIR/messages"
out=$("$root/relay-events")
check "messages: none stored" '.messages == {readable: true, reason: "", supervisor: true, conversations: []}'
msg() { # id, conversation, from, sent, created_at, kind, content, tags, participants
  echo "{\"id\":\"$1\",\"conversation\":\"$2\",\"participants\":$9,\"sent\":$4,\"from\":\"$3\",\"created_at\":$5,\"kind\":$6,\"content\":\"$7\",\"tags\":$8}"
}
two="[\"$pk\",\"$other\"]"; three="[\"$pk\",\"$other\",\"$third\"]"
{
  echo '{"supervisor":"not_running","messages":['
  msg m1 c1 "$other" false 10 14 'hello' "[[\"p\",\"$pk\"],[\"subject\",\"Reef\"]]" "$two"; echo ,
  msg m2 c1 "$pk" true 20 14 'hi back' "[[\"p\",\"$other\"],[\"e\",\"m1\",\"\",\"reply\"]]" "$two"; echo ,
  msg m3 c2 "$third" false 30 15 'https://a.example/f.bin' "[[\"p\",\"$pk\"],[\"p\",\"$other\"]]" "$three"; echo ,
  echo '"not a message",{"id":"m4"}'
  echo ']}'
} > "$STUB_DIR/messages"
out=$("$root/relay-events")
check "messages: grouped into conversations, the newest first" '.messages.readable == true and [.messages.conversations[].id] == ["c2","c1"]'
check "messages: a conversation names the others, not the agent" '.messages.conversations[1].participants == ["'"$other"'"] and (.messages.conversations[0].participants | sort) == ["'"$other"'","'"$third"'"]'
check "messages: oldest first within a conversation, each with who sent it" '[.messages.conversations[1].messages[] | [.id, .sent, .body]] == [["m1",false,"hello"],["m2",true,"hi back"]]'
check "messages: the subject, the time of the last and what a message replies to" '.messages.conversations[1] | .subject == "Reef" and .last_at == 20 and .messages[1].reply_to == "m1" and .messages[0].reply_to == null'
check "messages: a file message is marked" '.messages.conversations[0].messages[0] | .file == true and .body == "https://a.example/f.bin"'
check "messages: an entry that is not a message is skipped" '[.messages.conversations[].messages[].id] | sort == ["m1","m2","m3"]'
check "messages: a stopped supervisor is reported" '.messages.supervisor == false'
grep -q "message list" "$STUB_DIR/calls" && ! grep -q "message send" "$STUB_DIR/calls" || { echo "FAIL messages: only message list is run"; fails=$((fails + 1)); }
rm "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
out=$("$root/relay-events")
check "messages: without the public key file the agent is who sent" '.messages.conversations[1].participants == ["'"$other"'"]'
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
mkdir -p "$SPACETURTLE_STATE_DIR"; echo 25 > "$SPACETURTLE_STATE_DIR/last-looked"
out=$("$root/relay-events")
check "messages: one received since the Observer looked is news" '.attention == "news"'
echo 15 > "$SPACETURTLE_STATE_DIR/last-looked"
{ echo '{"supervisor":"running","messages":['; msg m1 c1 "$other" false 10 14 'hello' '[]' "$two"; echo ,; msg m2 c1 "$pk" true 20 14 'hi back' '[]' "$two"; echo ']}'; } > "$STUB_DIR/messages"
out=$("$root/relay-events")
check "messages: one the agent sent is not news" '.attention == "none"'
echo '{"agent_node":{"toon_apps":[{"apps":[{"name":"relay","running":false}]}]}}' > "$STUB_DIR/status"
out=$("$root/relay-events")
check "messages: read while the relay is not running" '.online == false and [.messages.conversations[].id] == ["c1"]'
new_env
out=$(SPACETURTLE_TOON=$tmp/bin/missing "$root/relay-events")
check "messages: no toon, none and not readable" '.messages == {readable: false, reason: "unavailable", supervisor: false, conversations: []}'

# --- persona Requests
