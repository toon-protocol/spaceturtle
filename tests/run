#!/bin/bash
# Runs relay-events against a stub `toon` and `curl` in a temporary home.
# Needs only bash and jq. Usage: tests/run
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
fails=0 count=0
tmps=()
trap 'rm -rf "${tmps[@]}"' EXIT

new_env() {
  tmp=$(mktemp -d); tmps+=("$tmp")
  export HOME=$tmp/home SPACETURTLE_CONFIG_DIR=$tmp/config SPACETURTLE_STATE_DIR=$tmp/state
  mkdir -p "$HOME/.local/bin" "$SPACETURTLE_CONFIG_DIR" "$tmp/bin"
  export SPACETURTLE_TOON=$tmp/bin/toon
  export STUB_DIR=$tmp/stub; mkdir -p "$STUB_DIR"
  # A curl that prints the NIP-11 document in $STUB_DIR/nip11, or fails.
  cat > "$HOME/.local/bin/curl" <<'STUB'
#!/bin/bash
[[ -r $STUB_DIR/nip11 ]] && cat "$STUB_DIR/nip11"
STUB
  chmod +x "$HOME/.local/bin/curl"
}

# A toon that answers from files in $STUB_DIR; the file for `toon event query`
# depends on the filter's kinds.
install_toon() {
  cat > "$SPACETURTLE_TOON" <<'STUB'
#!/bin/bash
echo "$*" >> "$STUB_DIR/calls"
case "$1 $2" in
  "status --json") cat "$STUB_DIR/status" ;;
  "relay config") cat "$STUB_DIR/config" ;;
  "relay subscriptions") echo '{"error":"not sold"}' ;;
  "event query")
    case "$*" in
      *'"authors"'*) if [[ -r $STUB_DIR/agent-events ]]; then cat "$STUB_DIR/agent-events"; else echo '{"events":[]}'; fi ;;
      *'"kinds":[0]'*) cat "$STUB_DIR/profiles" ;;
      *'"kinds":[3]'*) cat "$STUB_DIR/follows" ;;
      *) cat "$STUB_DIR/events" ;;
    esac ;;
  *) echo "unexpected toon $*" >&2; exit 1 ;;
esac
STUB
  chmod +x "$SPACETURTLE_TOON"
}

running_relay() {
  echo '{"agent_node":{"toon_apps":[{"apps":[{"name":"relay","running":true,"read_address":"127.0.0.1:7100"}]}]}}' > "$STUB_DIR/status"
  echo '{"relay":{"name":"Shelly"}}' > "$STUB_DIR/config"
}

check() { # name, jq expression that must be true of $out
  count=$((count + 1))
  if jq -e "$2" <<<"$out" >/dev/null 2>&1; then echo "ok   $1"
  else echo "FAIL $1"; echo "     expression: $2"; echo "     document:   $out"; fails=$((fails + 1)); fi
}

OFFLINE='.online == false and .name == "" and .self == "" and .subscribers == null and .profiles == [] and .follows == [] and .activity == [] and .last_active == null and .events == [] and .requests == [] and .node == {ilp_address: "", connector: ""}'
pk=$(printf 'a%.0s' {1..64}); other=$(printf 'b%.0s' {1..64})

# --- no toon
new_env
out=$(SPACETURTLE_TOON=$tmp/bin/missing "$root/relay-events")
check "no toon: the offline document" "$OFFLINE"

# --- relay not running
new_env; install_toon
echo '{"agent_node":{"toon_apps":[{"apps":[{"name":"relay","running":false}]}]}}' > "$STUB_DIR/status"
out=$("$root/relay-events")
check "relay not running: the offline document" "$OFFLINE"
! grep -q "event query" "$STUB_DIR/calls" || { echo "FAIL relay not running: queried the relay"; fails=$((fails + 1)); }

# --- a relay with events
new_env; install_toon; running_relay
echo "{\"events\":[{\"id\":\"e1\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":10,\"tags\":[],\"content\":\"hi\"},{\"id\":\"e2\",\"pubkey\":\"$other\",\"kind\":30023,\"created_at\":5,\"tags\":[],\"content\":\"long form\"}]}" > "$STUB_DIR/events"
echo "{\"events\":[{\"id\":\"p1\",\"pubkey\":\"$pk\",\"kind\":0,\"created_at\":1,\"tags\":[],\"content\":\"{\\\"name\\\":\\\"Shelly\\\"}\"}]}" > "$STUB_DIR/profiles"
echo "{\"events\":[{\"id\":\"f1\",\"pubkey\":\"$pk\",\"kind\":3,\"created_at\":2,\"tags\":[[\"p\",\"$other\"]],\"content\":\"\"}]}" > "$STUB_DIR/follows"
echo '{"name":"Shelly relay","ilp_address":"g.toon.shelly","connector":"https://node.example:8080"}' > "$STUB_DIR/nip11"
out=$("$root/relay-events" 25)
check "events: online, with the relay's name" '.online == true and .name == "Shelly"'
check "events: every event the relay returned" '[.events[].id] == ["e1","e2"]'
grep -q '"kinds":\[1,6,7,16,1111,30023\]' "$STUB_DIR/calls" || { echo "FAIL events: feed kinds not asked for"; fails=$((fails + 1)); }
check "events: profiles and follow lists" '(.profiles | length) == 1 and (.follows[0].tags == [["p","'"$other"'"]])'
grep -q '"limit":25' "$STUB_DIR/calls" || { echo "FAIL events: limit not passed"; fails=$((fails + 1)); }
check "events: ILP and connector come from NIP-11" '.node == {ilp_address: "g.toon.shelly", connector: "https://node.example:8080"}'
check "events: no public key file, no self" '.self == ""'
check "events: without a key the agent is unknown, and the Network holds every event" '.activity == [] and .last_active == null and ([.events[].id] == ["e1","e2"])'
check "events: subscribers null while not sold" '.subscribers == null'
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
out=$("$root/relay-events")
check "events: the public key file marks the agent" ".self == \"$pk\""
check "activity: the agent's events, apart from the Network's" '[.activity[].id] == ["e1"] and ([.events[].id] == ["e2"])'
check "activity: the time of the latest activity" '.last_active == 10'
echo "{\"events\":[{\"id\":\"e0\",\"pubkey\":\"$pk\",\"kind\":7,\"created_at\":20,\"tags\":[[\"e\",\"e2\"],[\"p\",\"$other\"]],\"content\":\"+\"}]}" > "$STUB_DIR/agent-events"
out=$("$root/relay-events")
check "activity: an agent event beyond the feed's limit is found, and says what it refers to" '[.activity[].id] == ["e0","e1"] and .activity[0].refers_to == "e2" and .activity[1].refers_to == null and .last_active == 20'
check "activity: the Network excludes the agent's events" '[.events[].id] == ["e2"]'
echo "{\"events\":[{\"id\":\"e0\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":5,\"tags\":[[\"e\",\"p1\",\"\",\"reply\"],[\"e\",\"r1\",\"\",\"root\"]],\"content\":\"re\"}]}" > "$STUB_DIR/agent-events"
out=$("$root/relay-events")
check "activity: newest first, wherever each event was found" '[.activity[].id] == ["e1","e0"] and .last_active == 10'
check "activity: a reply refers to the event marked reply, not the root" '.activity[1].refers_to == "p1"'
rm "$STUB_DIR/agent-events"
echo "{\"events\":[{\"id\":\"e2\",\"pubkey\":\"$other\",\"kind\":1,\"created_at\":5,\"tags\":[],\"content\":\"x\"}]}" > "$STUB_DIR/events"
out=$("$root/relay-events")
check "activity: an agent that has done nothing" '.self != "" and .activity == [] and .last_active == null'
echo "{\"events\":[{\"id\":\"e1\",\"pubkey\":\"$pk\",\"kind\":1,\"created_at\":10,\"tags\":[],\"content\":\"hi\"},{\"id\":\"e2\",\"pubkey\":\"$other\",\"kind\":30023,\"created_at\":5,\"tags\":[],\"content\":\"long form\"}]}" > "$STUB_DIR/events"
echo '{"ilp_address":5,"connector":"https://node.example:8080"}' > "$STUB_DIR/nip11"
out=$("$root/relay-events")
check "events: a non-string NIP-11 field leaves the other" '.node == {ilp_address: "", connector: "https://node.example:8080"}'
echo "not a key" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
out=$("$root/relay-events")
check "events: a malformed public key file is ignored" '.self == "" and .online == true'
rm "$STUB_DIR/nip11"
out=$("$root/relay-events")
check "events: without NIP-11 the feed still works" '.online == true and (.events | length) == 2 and .node.ilp_address == ""'
! grep -q "wallet" "$STUB_DIR/calls" || { echo "FAIL ran a wallet command"; fails=$((fails + 1)); }

# --- hostile profile fields stay data
new_env; install_toon; running_relay
hostile='{"name":"$(touch '"$tmp"'/pwned)","about":"`touch '"$tmp"'/pwned`; <script>","picture":"file:///etc/passwd","ilp_address":"evil","connector":"evil"}'
jq -cn --arg pk "$pk" --arg c "$hostile" '{events:[{id:"p1",pubkey:$pk,kind:0,created_at:1,tags:[],content:$c}]}' > "$STUB_DIR/profiles"
jq -cn --arg pk "$pk" --arg c '"; touch pwned #' '{events:[{id:"e1",pubkey:$pk,kind:1,created_at:2,tags:[],content:$c}]}' > "$STUB_DIR/events"
echo '{"events":[]}' > "$STUB_DIR/follows"
out=$("$root/relay-events")
count=$((count + 1))
if jq -e --arg h "$hostile" '.profiles[0].content == $h' <<<"$out" >/dev/null; then echo "ok   hostile: profile content passes through unchanged"
else echo "FAIL hostile: profile content changed"; fails=$((fails + 1)); fi
check "hostile: nothing becomes a node address" '.node.ilp_address == "" and .node.connector == ""'
echo '{"ilp_address":"g.toon.shelly","connector":"https://node.example:8080"}' > "$STUB_DIR/nip11"
out=$("$root/relay-events")
check "hostile: NIP-11, not the profile, gives the node addresses" '.node == {ilp_address: "g.toon.shelly", connector: "https://node.example:8080"}'
check "hostile: event content passes through unchanged" '.events[0].content == "\"; touch pwned #"'
[[ ! -e $tmp/pwned && ! -e pwned ]] || { echo "FAIL hostile: a command ran"; fails=$((fails + 1)); }

# --- requests: the request script
bad() { # name, command...: must exit non-zero
  local name=$1; shift; count=$((count + 1))
  if "$@" >/dev/null 2>&1; then echo "FAIL $name"; fails=$((fails + 1)); else echo "ok   $name"; fi
}
new_env
queue=$SPACETURTLE_STATE_DIR/requests
id=$("$root/request" add "Please follow someone interesting")
out=$(jq -c . "$queue/$id.json")
check "request: written as a waiting free Request" ".id == \"$id\" and .kind == \"free\" and .state == \"waiting\" and .text == \"Please follow someone interesting\" and (.created_at | type) == \"number\" and .answered_at == null and .result == null and .reason == null"
[[ $(ls "$queue" | wc -l) -eq 1 ]] || { echo "FAIL request: leftover files in the queue"; fails=$((fails + 1)); }
"$root/request" withdraw "$id"
count=$((count + 1))
if [[ ! -e $queue/$id.json ]]; then echo "ok   request: a waiting Request is withdrawn"; else echo "FAIL request: not withdrawn"; fails=$((fails + 1)); fi
bad "request: withdrawing it again is refused" "$root/request" withdraw "$id"
for state in done declined; do
  id=$("$root/request" add "answered $state")
  jq --arg s "$state" '.state = $s | .answered_at = 99' "$queue/$id.json" > "$tmp/x" && mv "$tmp/x" "$queue/$id.json"
  bad "request: a $state Request is not withdrawn" "$root/request" withdraw "$id"
  count=$((count + 1))
  if [[ -e $queue/$id.json ]]; then echo "ok   request: the $state Request is still there"; else echo "FAIL request: the $state Request was removed"; fails=$((fails + 1)); fi
done
bad "request: an id with a path is refused" "$root/request" withdraw "../../x"
bad "request: no text for a free Request is refused" "$root/request" add "  "
bad "request: an unknown kind is refused" "$root/request" add --kind nonsense "x"
nasty=$'He said "hi" \\ \'quoted\'\nsecond line $(touch '"$tmp"'/pwned) `touch '"$tmp"'/pwned`; touch pwned #\ttab *'
id=$("$root/request" add "$nasty")
count=$((count + 1))
if jq -e --arg t "$nasty" '.text == $t' "$queue/$id.json" >/dev/null; then echo "ok   request: quotes, newlines and shell characters are kept as text"
else echo "FAIL request: text changed"; fails=$((fails + 1)); fi
[[ ! -e $tmp/pwned && ! -e pwned ]] || { echo "FAIL request: a command ran"; fails=$((fails + 1)); }
id=$("$root/request" add --kind follow --pubkey "$pk" "and say hello")
out=$(jq -c . "$queue/$id.json")
check "request: a kind and a subject" ".kind == \"follow\" and .subject == {pubkey: \"$pk\", event: null}"

# --- requests in the observation document
new_env; install_toon; running_relay
queue=$SPACETURTLE_STATE_DIR/requests; mkdir -p "$queue"
echo '{"events":[]}' > "$STUB_DIR/events"; echo '{"events":[]}' > "$STUB_DIR/profiles"; echo '{"events":[]}' > "$STUB_DIR/follows"
echo "$pk" > "$SPACETURTLE_CONFIG_DIR/agent-pubkey"
ev=$(printf 'c%.0s' {1..64})
out=$("$root/relay-events")
check "requests: none in the queue" '.requests == [] and .activity == []'
echo "{\"id\":\"w\",\"created_at\":100,\"kind\":\"free\",\"subject\":{},\"text\":\"waiting one\",\"state\":\"waiting\",\"answered_at\":null,\"result\":null,\"reason\":null}" > "$queue/1-aa.json"
echo "{\"id\":\"d\",\"created_at\":110,\"kind\":\"free\",\"subject\":{},\"text\":\"done one\",\"state\":\"done\",\"answered_at\":150,\"result\":{\"event\":\"$ev\"},\"reason\":null}" > "$queue/2-bb.json"
echo "{\"id\":\"x\",\"created_at\":120,\"kind\":\"free\",\"subject\":{},\"text\":\"declined one\",\"state\":\"declined\",\"answered_at\":140,\"result\":null,\"reason\":\"Not in character\"}" > "$queue/3-cc.json"
out=$("$root/relay-events")
check "requests: listed newest first with their states" '[.requests[] | [.id, .state]] == [["3-cc","declined"],["2-bb","done"],["1-aa","waiting"]]'
check "requests: the answer and the reason" '.requests[1].result.event == "'"$ev"'" and .requests[0].reason == "Not in character"'
check "requests: answered ones are Activity entries, newest first; a waiting one is not" '[.activity[].id] == ["request:2-bb","request:3-cc"]'
check "requests: a done entry refers to what the agent published" '.activity[0].refers_to == "'"$ev"'" and .activity[0].request.state == "done" and .activity[0].created_at == 150'
check "requests: a declined entry carries the reason" '.activity[1].refers_to == null and .activity[1].request.reason == "Not in character"'
check "requests: an outcome is the agent's last activity" '.last_active == 150'
echo '{"events":[{"id":"e1","pubkey":"'"$pk"'","kind":1,"created_at":200,"tags":[],"content":"hi"}]}' > "$STUB_DIR/events"
out=$("$root/relay-events")
check "requests: outcomes and events share the Activity" '[.activity[].id] == ["e1","request:2-bb","request:3-cc"] and .last_active == 200'
echo '{ not json' > "$queue/4-dd.json"
echo '[1,2]' > "$queue/5-ee.json"
echo '{"id":"m","created_at":"soon","kind":"free","text":"t","state":"waiting"}' > "$queue/6-ff.json"
echo '{"id":"m","created_at":1,"kind":"free","text":"t","state":"whatever"}' > "$queue/7-gg.json"
: > "$queue/8-hh.json"
out=$("$root/relay-events")
check "requests: malformed files are skipped and the document is whole" '.online == true and [.requests[].id] == ["3-cc","2-bb","1-aa"] and (.activity | length) == 3'
echo '{"agent_node":{"toon_apps":[{"apps":[{"name":"relay","running":false}]}]}}' > "$STUB_DIR/status"
out=$("$root/relay-events")
check "requests: still listed while the relay is not running" '.online == false and (.requests | length) == 3 and .activity == []'

echo; echo "$count checks, $fails failed"
[[ $fails -eq 0 ]]
