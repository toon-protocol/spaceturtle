#!/bin/bash
# Record that the Observer looked: relay-events then reports no news older
# than now. Writes one file and nothing else.
#   SPACETURTLE_STATE_DIR   (default: ~/.local/state/spaceturtle)
set -eu
state_dir=${SPACETURTLE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/spaceturtle}
mkdir -p "$state_dir"
date +%s > "$state_dir/last-looked.$$"
mv -f "$state_dir/last-looked.$$" "$state_dir/last-looked"
