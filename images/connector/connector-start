#!/bin/bash
# The connector's zone's entrypoint, and what the launcher's unit runs in the zone. Starts the
# container engine if it is not running, the two forwarders an agent key is used through, then
# the supervisor in this process, so nothing needs `systemd --user` (`toon up` without
# --foreground installs a unit). The passphrase file is the one the launcher made in this
# zone. Until `toon init` has written the passphrase file there is nothing to supervise, so
# it waits for that file with the engine up, then starts the supervisor.
set -euo pipefail

if ! docker info >/dev/null 2>&1; then
  # The launcher keeps /run in memory, so the engine finds nothing there from before the zone
  # last stopped: a pid file left on a disk would keep it from starting.
  sudo sh -c 'setsid nohup dockerd > /var/log/dockerd.log 2>&1 < /dev/null &'
  for _ in $(seq 60); do
    docker info >/dev/null 2>&1 && break
    sleep 1
  done
  docker info >/dev/null 2>&1 || { echo "connector-start: the container engine did not start" >&2; exit 1; }
fi

export TOON_PASSPHRASE_FILE=${TOON_PASSPHRASE_FILE:-$HOME/.config/toon/passphrase}
if [[ ! -r $TOON_PASSPHRASE_FILE ]]; then
  echo "connector-start: no passphrase file at $TOON_PASSPHRASE_FILE; the container engine is up, waiting for toon init" >&2
  until [[ -r $TOON_PASSPHRASE_FILE ]]; do sleep 5; done
fi

home=$HOME/.toon/agent-node
# A zone that was stopped leaves the supervisor's socket behind, which `toon up` could take
# for a node that is running.
pgrep -f "[t]oon up" >/dev/null || rm -f "$home/supervisor.sock"

# The supervisor's orders and the relay TOON app's connector listen on loopback, which a
# published port does not reach. A forwarder on the zone's own address leads to each: 17100
# to the orders, 17101 to the connector. The launcher publishes those two to the machine's
# loopback. They listen on that one address, which is not on any app's network: the zone's
# own interface is there from the start, so its address comes before any the engine adds.
own_address=$(hostname -I | tr ' ' '\n' | grep -m1 -E '^[0-9]+(\.[0-9]+){3}$' || true)
forward() { # listening port, the loopback port it leads to
  [[ -n $own_address ]] || { echo "connector-start: the zone's own address is not known, so port $1 is not forwarded" >&2; return 0; }
  [[ $2 =~ ^[0-9]+$ ]] || { echo "connector-start: nothing to forward port $1 to yet" >&2; return 0; }
  pgrep -f "socat TCP-LISTEN:$1," >/dev/null && return 0
  setsid nohup socat "TCP-LISTEN:$1,bind=$own_address,fork,reuseaddr" "TCP:127.0.0.1:$2" >/dev/null 2>&1 < /dev/null &
}
forward 17100 "$(jq -r '.supervisor // "" | sub(".*:"; "")' "$home/agent-keys.json" 2>/dev/null)"
forward 17101 "$(jq -r '.toon_apps[0].listen // "" | sub(".*:"; "")' "$home/state.json" 2>/dev/null)"

exec toon up --foreground
