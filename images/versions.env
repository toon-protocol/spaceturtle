# Everything the two zone images add to their bases, pinned. images/versions prints it;
# the Dockerfiles take it as build arguments (the images workflow passes this file) and
# have no defaults of their own, so a version lives only here.
# A base is pinned by its digest. To bump one, change it here, in one commit.

# toon, from toon-protocol/toon_cli. The checksums are those of the release's SHA256SUMS.
TOON_VERSION=0.2.0
TOON_SHA256_AMD64=8fe0acd614187493c665fff810543b3f618806bd373933835824d545591f5238
TOON_SHA256_ARM64=e20d77547050d60821223c98ef63e68bc75d22d465eda6eb330cdff291c44135

# The agent's zone: docker-agent's own sandbox image (docker/docker-agent-sbx-templates),
# the release that goes with the docker-agent the agent definition is tested with. Both bases
# are Docker's images for its own sandboxes; the launcher runs them under microsandbox, which
# install.sh pins.
DOCKER_AGENT_VERSION=1.150.0
DOCKER_AGENT_BASE_DIGEST=sha256:67edb4cf7eaa8b0ae8ad9021abf1e1bcb2f788d363234491f629ac64afb387cb
# The docker-agent program of that release, which a release publishes the agent definition
# with. It goes into no image. The checksum is the digest GitHub records for the release's
# docker-agent-linux-amd64.
DOCKER_AGENT_SHA256_AMD64=791fa6bac9f829847f00ab948f838bf54d11e0830988a5e5bce88d65ea65f2d1

# The connector's zone: Docker Sandboxes' shell sandbox with its own container engine
# (docker/sandbox-templates:shell-docker).
CONNECTOR_BASE_DIGEST=sha256:1560168ac5fb9ce23d413c878349334c5845c07e264cd675d7867f0c78ad1761

# The sandboxed runtime for images that are not TOON's own, from gvisor.dev. The checksums
# are those of the release's gvisor.tar.bz2.sha512.
GVISOR_VERSION=20261005.0
GVISOR_SHA512_AMD64=79869ae9a589355a46d46fdac068d9a954e741741ffe77c64e38c56ea955498c1cb04e9bce44e1cce5155333e6b76bee72347c6661bb7c78fd2fe3aad198c8fe
GVISOR_SHA512_ARM64=1bc58be6f881264ced1df8ff61db0205531abedcace005585ac5637c5c987831062b365f99f270ef0939849f130344b84e0f1a663294406f798b8f7c8cd326ac
