#!/bin/bash
# Prints the versions the two zone images carry, for release notes. Usage: images/versions
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=versions.env
. "$here/versions.env"
cat <<OUT
agent's zone image
  docker-agent sandbox image  docker/docker-agent-sbx-templates:$DOCKER_AGENT_VERSION@$DOCKER_AGENT_BASE_DIGEST
  docker-agent                $DOCKER_AGENT_VERSION, built from $DOCKER_AGENT_COMMIT with the banner patch, by Go $GO_VERSION
  toon                        $TOON_VERSION (sha256 verified)
connector's zone image
  sandbox base                docker/sandbox-templates:shell-docker@$CONNECTOR_BASE_DIGEST
  toon                        $TOON_VERSION (sha256 verified)
  gVisor (runsc)              $GVISOR_VERSION (sha512 verified)
OUT
